{
  "name": "nogiti-platform",
  "version": "1.1.0",
  "private": true,
  "description": "Nogiti engineering tools, courses, AutoCAD plugins, articles and admin CMS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:status": "node scripts/migrate.js --status",
    "admin:create": "node scripts/create-admin.js",
    "lint:syntax": "node scripts/check-syntax.js",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:all": "npm run test && npm run test:integration",
    "test:ui": "node scripts/e2e-ui.js",
    "check": "npm run lint:syntax && npm test"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "pg": "^8.13.1"
  }
}
