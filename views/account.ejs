<%- include('partials/header', {title}) %>
<section class="account-section section"><div class="container"><div class="account-welcome"><div><span class="section-kicker">MY Nogiti</span><h1>سلام <%= currentUser.first_name || 'مهندس' %>، خوش آمدید.</h1><p>از اینجا پروفایل، سفارش‌ها و محتوای خریداری‌شده‌تان را مدیریت کنید.</p></div><div class="account-avatar"><%= (currentUser.first_name || currentUser.phone).slice(0,1) %></div></div><div class="account-layout"><aside class="account-side"><div class="account-side-user"><span class="avatar-large"><%= (currentUser.first_name || currentUser.phone).slice(0,1) %></span><b><%= (currentUser.first_name+' '+currentUser.last_name).trim() || 'کاربر Nogiti' %></b><small><%= currentUser.phone %></small></div><a class="account-side-link selected" href="#library">کتابخانه من</a><a class="account-side-link" href="#orders">سفارش‌ها</a><a class="account-side-link" href="/account/tickets"><%= t('tickets.title') %></a><a class="account-side-link" href="#profile">اطلاعات حساب</a></aside><div class="account-main"><section class="account-panel" id="library"><div class="account-panel-head"><div><span class="section-kicker">LEARNING LIBRARY</span><h2>کتابخانه من</h2></div><span class="soft-count"><%= library.length %> محصول</span></div><% if (library.length) { %><div class="library-list"><% library.forEach((p,i) => { %><a class="library-item" href="/shop/<%= p.slug %>"><span class="library-thumb <%= p.cover_image?'has-cover':'' %>"><% if (p.cover_image) { %><img src="<%= p.cover_image %>" alt=""><% } else { %><b><%= p.product_type==='course'?'C':'N' %></b><% } %></span><span class="library-info"><b><%= p.title %></b><small><%= p.product_type==='course'?'دوره آموزشی':'افزونه اتوکد' %></small></span><span class="library-status">فعال ✓</span></a><% if (p.assets && p.assets.length) { %><div class="library-assets"><h3>محتوای در دسترس</h3><% p.assets.forEach(a => { %><div class="library-asset"><div class="library-asset-heading"><span><%= a.asset_kind==='video'?'▶':a.asset_kind==='pdf'?'▤':'↓' %></span><b><%= a.title %></b></div><% if (a.asset_kind==='video') { %><video class="library-video" controls preload="none" src="/secure-assets/<%= a.id %>" aria-label="<%= a.title %>">مرورگر شما از پخش ویدئو پشتیبانی نمی‌کند.</video><% } else { %><a class="library-asset-link" href="/secure-assets/<%= a.id %>"><%= a.asset_kind==='pdf'?'مشاهده PDF':'دریافت فایل یا مشاهده محتوا' %> ←</a><% } %></div><% }) %></div><% } %><% }) %></div><% } else { %><div class="empty-state empty-compact"><span>▤</span><h3>کتابخانه شما هنوز خالی است</h3><p>پس از خرید و تأیید پرداخت، دوره‌ها و فایل‌ها در این بخش فعال می‌شوند.</p><a class="button button-primary" href="/shop">رفتن به فروشگاه</a></div><% } %></section>
<section class="account-panel" id="orders"><div class="account-panel-head"><div><span class="section-kicker">ORDER HISTORY</span><h2>سفارش‌های اخیر</h2></div></div><% if (orders.length) { %><div class="table-responsive"><table class="data-table"><thead><tr><th>شماره سفارش</th><th>تاریخ</th><th>مبلغ</th><th>وضعیت</th></tr></thead><tbody><% orders.forEach(o => { %><tr><td>#<%= o.id %></td><td><%= new Date(o.created_at).toLocaleDateString('fa-IR') %></td><td><%= money(o.total_toman) %></td><td><span class="status-pill status-<%= o.status %>"><%= o.status==='paid'?'پرداخت موفق':o.status==='pending'?'در انتظار پرداخت':o.status==='failed'?'ناموفق':'لغوشده' %></span></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted-text">هنوز سفارشی ثبت نشده است.</p><% } %></section>
<section class="account-panel" id="profile"><div class="account-panel-head"><div><span class="section-kicker">PROFILE SETTINGS</span><h2>اطلاعات حساب</h2></div></div><form action="/account/profile" method="post" class="profile-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div><label for="firstName">نام</label><input class="form-control" id="firstName" name="firstName" value="<%= currentUser.first_name %>" required></div><div><label for="lastName">نام خانوادگی</label><input class="form-control" id="lastName" name="lastName" value="<%= currentUser.last_name %>" required></div><div><label for="branch">شاخه فعالیت</label><select class="form-control" id="branch" name="branch"><% ['','نظارت','طراحی','اجرا'].forEach(v=>{ %><option value="<%= v %>" <%= currentUser.branch===v?'selected':'' %>><%= v || 'انتخاب نشده' %></option><% }) %></select></div><div><label for="field">رشته تخصصی</label><select class="form-control" id="field" name="field"><% ['','مهندسی مکانیک','مهندسی برق','مهندسی عمران','مهندسی معماری','سایر'].forEach(v=>{ %><option value="<%= v %>" <%= currentUser.field===v?'selected':'' %>><%= v || 'انتخاب نشده' %></option><% }) %></select></div></div><div class="profile-bottom"><span class="muted-text">شماره موبایل: <b><%= currentUser.phone %></b></span><button class="button button-dark" type="submit">ذخیره تغییرات</button></div></form></section></div></div></div></section>
<%- include('partials/footer') %>
