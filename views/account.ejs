<%- include('partials/header', {title}) %>
<% const branchLabels = { '': t('account.notSelected'), 'نظارت': t('account.branch.supervision'), 'طراحی': t('account.branch.design'), 'اجرا': t('account.branch.execution') };
   const fieldLabels = { '': t('account.notSelected'), 'مهندسی مکانیک': t('account.field.mechanical'), 'مهندسی برق': t('account.field.electrical'), 'مهندسی عمران': t('account.field.civil'), 'مهندسی معماری': t('account.field.architecture'), 'سایر': t('account.field.other') };
%>
<section class="account-section section"><div class="container"><div class="account-welcome"><div><span class="section-kicker">MY Novingity</span><h1><%= t('account.greeting') %> <%= currentUser.first_name || t('account.engineerFallback') %>, <%= t('account.welcome') %></h1><p><%= t('account.welcomeDesc') %></p></div><div class="account-avatar"><%= (currentUser.first_name || currentUser.phone).slice(0,1) %></div></div><div class="account-layout"><aside class="account-side"><div class="account-side-user"><span class="avatar-large"><%= (currentUser.first_name || currentUser.phone).slice(0,1) %></span><b><%= (currentUser.first_name+' '+currentUser.last_name).trim() || t('account.userFallback') %></b><small><%= currentUser.phone %></small></div><a class="account-side-link selected" href="#library"><%= t('account.libraryNav') %></a><a class="account-side-link" href="#orders"><%= t('account.ordersNav') %></a><a class="account-side-link" href="/account/tickets"><%= t('tickets.title') %></a><a class="account-side-link" href="#profile"><%= t('account.profileNav') %></a></aside><div class="account-main"><section class="account-panel" id="library"><div class="account-panel-head"><div><span class="section-kicker">LEARNING LIBRARY</span><h2><%= t('account.libraryTitle') %></h2></div><span class="soft-count"><%= library.length %> <%= t('account.productCount') %></span></div><% if (library.length) { %><div class="library-list"><% library.forEach((p,i) => { %><a class="library-item" href="/shop/<%= p.slug %>"><span class="library-thumb <%= p.cover_image?'has-cover':'' %>"><% if (p.cover_image) { %><img src="<%= p.cover_image %>" alt=""><% } else { %><b><%= p.product_type==='course'?'C':'N' %></b><% } %></span><span class="library-info"><b><%= p.title %></b><small><%= p.product_type==='course'?t('home.shop.courseLabel'):t('home.shop.pluginLabel') %></small></span><span class="library-status"><%= t('account.activeStatus') %> ✓</span></a><% if (p.assets && p.assets.length) { %><div class="library-assets"><h3><%= t('account.availableContent') %></h3><% p.assets.forEach(a => { %><div class="library-asset"><div class="library-asset-heading"><span><%= a.asset_kind==='video'?'▶':a.asset_kind==='pdf'?'▤':'↓' %></span><b><%= a.title %></b></div><% if (a.asset_kind==='video') { %><video class="library-video" controls preload="none" src="/secure-assets/<%= a.id %>" aria-label="<%= a.title %>"><%= t('account.videoUnsupported') %></video><% } else { %><a class="library-asset-link" href="/secure-assets/<%= a.id %>"><%= a.asset_kind==='pdf'?t('account.viewPdf'):t('account.downloadOrView') %> ←</a><% } %></div><% }) %></div><% } %><% }) %></div><% } else { %><div class="empty-state empty-compact"><span>▤</span><h3><%= t('account.libraryEmptyTitle') %></h3><p><%= t('account.libraryEmptyDesc') %></p><a class="button button-primary" href="/shop"><%= t('account.goToShop') %></a></div><% } %></section>
<section class="account-panel" id="orders"><div class="account-panel-head"><div><span class="section-kicker">ORDER HISTORY</span><h2><%= t('account.recentOrders') %></h2></div></div><% if (orders.length) { %><div class="table-responsive"><table class="data-table"><thead><tr><th><%= t('account.orderNumber') %></th><th><%= t('common.date') %></th><th><%= t('account.amount') %></th><th><%= t('common.status') %></th></tr></thead><tbody><% orders.forEach(o => { %><tr><td>#<%= o.id %></td><td><%= new Date(o.created_at).toLocaleDateString(locale==='en'?'en-US':'fa-IR') %></td><td><%= money(o.total_toman) %></td><td><span class="status-pill status-<%= o.status %>"><%= o.status==='paid'?t('account.orderPaid'):o.status==='pending'?t('account.orderPending'):o.status==='failed'?t('account.orderFailed'):t('account.orderCancelled') %></span></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted-text"><%= t('account.noOrdersYet') %></p><% } %></section>
<section class="account-panel" id="profile"><div class="account-panel-head"><div><span class="section-kicker">PROFILE SETTINGS</span><h2><%= t('account.profileTitle') %></h2></div></div><form action="/account/profile" method="post" class="profile-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div><label for="firstName"><%= t('login.firstName') %></label><input class="form-control" id="firstName" name="firstName" value="<%= currentUser.first_name %>" required></div><div><label for="lastName"><%= t('login.lastName') %></label><input class="form-control" id="lastName" name="lastName" value="<%= currentUser.last_name %>" required></div><div><label for="branch"><%= t('account.branchLabel') %></label><select class="form-control" id="branch" name="branch"><% ['','نظارت','طراحی','اجرا'].forEach(v=>{ %><option value="<%= v %>" <%= currentUser.branch===v?'selected':'' %>><%= branchLabels[v] %></option><% }) %></select></div><div><label for="field"><%= t('account.fieldLabel') %></label><select class="form-control" id="field" name="field"><% ['','مهندسی مکانیک','مهندسی برق','مهندسی عمران','مهندسی معماری','سایر'].forEach(v=>{ %><option value="<%= v %>" <%= currentUser.field===v?'selected':'' %>><%= fieldLabels[v] %></option><% }) %></select></div></div><div class="profile-bottom"><span class="muted-text"><%= t('account.mobileLabel') %>: <b><%= currentUser.phone %></b></span><button class="button button-dark" type="submit"><%= t('account.saveChanges') %></button></div></form></section></div></div></div></section>
<%- include('partials/footer') %>
