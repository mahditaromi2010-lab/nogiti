<%- include('partials/header', {title}) %>
<section class="account-section section"><div class="container">
  <div class="account-welcome"><div><span class="section-kicker">SUPPORT</span><h1><%= t('tickets.myTickets') %></h1><p><%= t('tickets.title') %></p></div><a class="button button-primary" href="/account/tickets/new">＋ <%= t('tickets.newTicket') %></a></div>
  <section class="account-panel">
    <% if (tickets.length) { %>
    <div class="table-responsive"><table class="data-table"><caption class="sr-only"><%= t('tickets.myTickets') %></caption><thead><tr><th scope="col">#</th><th scope="col"><%= t('tickets.subject') %></th><th scope="col"><%= t('common.category') %></th><th scope="col"><%= t('common.status') %></th><th scope="col"><%= t('common.date') %></th></tr></thead><tbody>
      <% tickets.forEach(tk => { %><tr><td><a href="/account/tickets/<%= tk.id %>">#<%= tk.id %></a></td><td><a href="/account/tickets/<%= tk.id %>"><%= tk.subject %></a></td><td><%= t('tickets.category.'+tk.category) %></td><td><span class="status-pill status-ticket-<%= tk.status %>"><%= t('tickets.status.'+tk.status) %></span></td><td><%= new Date(tk.created_at).toLocaleDateString('fa-IR') %></td></tr><% }) %>
    </tbody></table></div>
    <% } else { %>
    <div class="empty-state empty-compact"><span>✉</span><h3><%= t('tickets.empty') %></h3><a class="button button-outline" href="/account/tickets/new"><%= t('tickets.newTicket') %></a></div>
    <% } %>
  </section>
</div></section>
<%- include('partials/footer') %>
