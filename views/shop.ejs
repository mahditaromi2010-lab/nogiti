<%- include('partials/header', {title}) %>
<section class="page-hero"><div class="container"><div class="breadcrumb"><a href="/"><%= t('tools.breadcrumbHome') %></a><span>/</span><span><%= t('shop.breadcrumbSelf') %></span></div><span class="section-kicker">Novingity MARKET</span><h1><%= t('shop.titlePre') %><br><em><%= t('shop.titleEm') %></em></h1><p><%= t('shop.lead') %></p></div></section>
<%- include('partials/flow-divider') %>
<section class="section"><div class="container"><form class="shop-filters" method="get" action="/shop"><div class="search-field"><span>⌕</span><input name="q" value="<%= q %>" placeholder="<%= t('shop.searchPlaceholder') %>"></div><div class="filter-tabs"><a class="<%= !type ? 'selected' : '' %>" href="/shop"><%= t('shop.filterAll') %></a><a class="<%= type==='course' ? 'selected' : '' %>" href="/shop?type=course"><%= t('shop.filterCourses') %></a><a class="<%= type==='plugin' ? 'selected' : '' %>" href="/shop?type=plugin"><%= t('shop.filterPlugins') %></a></div><button class="button button-dark" type="submit"><%= t('shop.searchSubmit') %></button></form>
<% if (products.length) { %><div class="product-grid product-grid-shop reveal-stagger"><% products.forEach((p, i) => { %><% const pTitle = localizedField(p,'title','title_en'); %><a class="product-card reveal-item" href="/shop/<%= p.slug %>"><div class="product-cover <%= p.cover_image ? 'has-cover' : 'cover-'+(i%3) %>"><% if (p.cover_image) { %><img src="<%= p.cover_image %>" alt="<%= pTitle %>" loading="lazy"><% } else { %><span class="cover-big-letter"><%= p.product_type==='course'?'C':'N' %></span><span class="cover-tag"><%= p.product_type==='course'?'Novingity ACADEMY':'Novingity TOOLS' %></span><% } %><span class="cover-type"><%= p.product_type==='course'?t('home.shop.courseLabel'):t('home.shop.pluginLabel') %></span></div><div class="product-body"><div class="product-category"><%= p.category || t('home.shop.categoryFallback') %></div><h3><%= pTitle %></h3><p><%= localizedField(p,'short_description','short_description_en') %></p><div class="product-meta"><strong><%= money(p.price_toman) %></strong><span><%= t('shop.productDetails') %> ←</span></div></div></a><% }) %></div><% } else { %><div class="empty-state"><span>⌕</span><h3><%= t('shop.emptyTitle') %></h3><p><%= t('shop.emptyDesc') %></p><a href="/shop" class="button button-outline"><%= t('shop.clearFilters') %></a></div><% } %>
</div></section>
<%- include('partials/footer') %>
