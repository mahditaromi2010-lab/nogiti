<%- include('partials/header', {title}) %>
<section class="page-hero"><div class="container"><div class="breadcrumb"><a href="/">خانه</a><span>/</span><span>فروشگاه</span></div><span class="section-kicker">Nogiti MARKET</span><h1>ابزار و آموزش،<br><em>برای کار دقیق‌تر.</em></h1><p>دوره‌های تخصصی و افزونه‌های مهندسی را بررسی کنید. دسترسی به محتوای کامل هر محصول پس از تأیید پرداخت فعال می‌شود.</p></div></section>
<section class="section"><div class="container"><form class="shop-filters" method="get" action="/shop"><div class="search-field"><span>⌕</span><input name="q" value="<%= q %>" placeholder="جست‌وجوی دوره یا افزونه..."></div><div class="filter-tabs"><a class="<%= !type ? 'selected' : '' %>" href="/shop">همه محصولات</a><a class="<%= type==='course' ? 'selected' : '' %>" href="/shop?type=course">دوره‌ها</a><a class="<%= type==='plugin' ? 'selected' : '' %>" href="/shop?type=plugin">افزونه‌های اتوکد</a></div><button class="button button-dark" type="submit">جست‌وجو</button></form>
<% if (products.length) { %><div class="product-grid product-grid-shop"><% products.forEach((p, i) => { %><% const pTitle = localizedField(p,'title','title_en'); %><a class="product-card" href="/shop/<%= p.slug %>"><div class="product-cover <%= p.cover_image ? 'has-cover' : 'cover-'+(i%3) %>"><% if (p.cover_image) { %><img src="<%= p.cover_image %>" alt="تصویر <%= pTitle %>" loading="lazy"><% } else { %><span class="cover-big-letter"><%= p.product_type==='course'?'C':'N' %></span><span class="cover-tag"><%= p.product_type==='course'?'Nogiti ACADEMY':'Nogiti TOOLS' %></span><% } %><span class="cover-type"><%= p.product_type==='course'?'دوره آموزشی':'افزونه اتوکد' %></span></div><div class="product-body"><div class="product-category"><%= p.category || 'تخصصی' %></div><h3><%= pTitle %></h3><p><%= localizedField(p,'short_description','short_description_en') %></p><div class="product-meta"><strong><%= money(p.price_toman) %></strong><span>جزئیات محصول ←</span></div></div></a><% }) %></div><% } else { %><div class="empty-state"><span>⌕</span><h3>محصولی پیدا نشد</h3><p>عبارت جست‌وجو یا فیلتر را تغییر دهید. محصولات منتشرشده در اینجا نمایش داده می‌شوند.</p><a href="/shop" class="button button-outline">پاک کردن فیلترها</a></div><% } %>
</div></section>
<%- include('partials/footer') %>
