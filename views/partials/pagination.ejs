<%# Expects: pg {page,pages,total,pageSize}, base (path), params (object of current filters) %>
<% if (pg && pg.total > 0) { %>
<% const numLocale = locale === 'en' ? 'en-US' : 'fa-IR'; %>
<nav class="pager" aria-label="<%= t('pagination.ariaLabel') %>">
  <span class="pager-info"><%= t('pagination.showing') %> <%= Number((pg.page - 1) * pg.pageSize + 1).toLocaleString(numLocale) %> <%= t('pagination.to') %> <%= Number(Math.min(pg.page * pg.pageSize, pg.total)).toLocaleString(numLocale) %> <%= t('pagination.of') %> <%= Number(pg.total).toLocaleString(numLocale) %></span>
  <% if (pg.pages > 1) { %>
  <span class="pager-links">
    <% if (pg.page > 1) { %><a class="button button-outline button-small" rel="prev" href="<%= base %><%= qs({ ...params, page: pg.page - 1 }) %>">→ <%= t('pagination.previous') %></a><% } else { %><span class="button button-outline button-small is-disabled" aria-disabled="true">→ <%= t('pagination.previous') %></span><% } %>
    <span class="pager-current" aria-current="page"><%= t('pagination.page') %> <%= Number(pg.page).toLocaleString(numLocale) %> <%= t('pagination.ofPages') %> <%= Number(pg.pages).toLocaleString(numLocale) %></span>
    <% if (pg.page < pg.pages) { %><a class="button button-outline button-small" rel="next" href="<%= base %><%= qs({ ...params, page: pg.page + 1 }) %>"><%= t('pagination.next') %> ←</a><% } else { %><span class="button button-outline button-small is-disabled" aria-disabled="true"><%= t('pagination.next') %> ←</span><% } %>
  </span>
  <% } %>
</nav>
<% } %>
