<!doctype html>
<html lang="<%= htmlLang %>" dir="<%= htmlDir %>" data-locale="<%= locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b2e26">
  <!-- Nogiti site icons -->
  <link rel="icon" href="/public/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="48x48" href="/public/favicon-48x48.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/public/favicon-32x32.png">
  <link rel="apple-touch-icon" href="/public/apple-touch-icon.png">
  <link rel="manifest" href="/public/site.webmanifest">
  <meta name="description" content="Nogiti؛ ابزارهای مهندسی تأسیسات، آموزش تخصصی، دوره‌های کاربردی و افزونه‌های اتوکد.">
  <title><%= title ? `${title} | ${siteName}` : `${siteName} | ابزارهای مهندسی و آموزش تأسیسات` %></title>
  <link rel="preload" href="/public/fonts/Vazirmatn-Variable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/public/css/styles.css">
  <script defer src="/public/js/main.js"></script>
</head>
<body>
<a class="skip-link" href="#main-content">پرش به محتوای اصلی</a>
<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href="/" aria-label="<%= siteName %> - صفحه اصلی"><span class="brand-mark"><img src="/public/images/nogiti-logo-96.webp" srcset="/public/images/nogiti-logo-96.webp 2x, /public/images/nogiti-logo-144.webp 3x" alt="" width="48" height="48" decoding="async"></span><span><strong><%= siteName %></strong><small><%= siteTagline %></small></span></a>
    <button class="mobile-toggle" type="button" aria-label="باز کردن منو" aria-controls="main-nav" aria-expanded="false" data-menu-toggle><span></span><span></span><span></span></button>
    <nav class="main-nav" id="main-nav" aria-label="منوی اصلی" data-nav>
      <a href="/tools"><%= t('nav.tools') %></a>
      <a href="/shop"><%= t('nav.shop') %></a>
      <a href="/articles"><%= t('nav.articles') %></a>
      <a href="/about"><%= t('nav.about') %></a>
      <% if (currentUser) { %><a href="/account/tickets"><%= t('nav.support') %></a><% } %>
      <% if (currentAdmin) { %><a href="<%= can('overview') ? '/admin' : (roleHome || '/admin/account') %>" class="nav-admin"><%= t('nav.admin') %></a><% } %>
    </nav>
    <div class="nav-actions">
      <div class="lang-switch" role="group" aria-label="<%= t('nav.language') %>">
        <a href="/lang/fa?next=<%= encodeURIComponent(currentPath) %>" class="lang-option <%= locale==='fa'?'is-active':'' %>" lang="fa">فا</a>
        <a href="/lang/en?next=<%= encodeURIComponent(currentPath) %>" class="lang-option <%= locale==='en'?'is-active':'' %>" lang="en">EN</a>
      </div>
      <% if (currentAdmin) { %>
        <a class="user-chip" href="/admin/account"><span class="avatar-mini"><%= currentAdmin.username.slice(0,1).toUpperCase() %></span><span><%= currentAdmin.username %></span></a>
        <form action="/admin/logout" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small" type="submit"><%= t('nav.adminLogout') %></button></form>
      <% } else if (currentUser) { %>
        <a class="user-chip" href="/account"><span class="avatar-mini"><%= (currentUser.first_name || currentUser.phone).slice(0,1) %></span><span><%= currentUser.first_name || t('nav.account') %></span></a>
        <form action="/logout" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small" type="submit"><%= t('nav.logout') %></button></form>
      <% } else { %>
        <a class="button button-dark button-small" href="/login"><%= t('nav.login') %></a>
      <% } %>
    </div>
  </div>
</header>
<% if (flash) { %><div class="container flash-wrap"><div class="flash flash-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>"><%= flash.message %><button type="button" aria-label="بستن پیام" data-flash-close>×</button></div></div><% } %>
<main id="main-content" tabindex="-1">
