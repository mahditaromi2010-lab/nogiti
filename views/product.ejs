<%- include('partials/header', {title}) %>
<% const productTitle = localizedField(product,'title','title_en'); const productShortDesc = localizedField(product,'short_description','short_description_en'); const productDesc = localizedField(product,'description','description_en'); %>
<section class="section product-detail-section"><div class="container"><div class="breadcrumb"><a href="/"><%= t('tools.breadcrumbHome') %></a><span>/</span><a href="/shop"><%= t('shop.breadcrumbSelf') %></a><span>/</span><span><%= productTitle %></span></div><div class="product-detail-grid"><div class="product-detail-visual"><div class="product-cover detail-cover <%= product.cover_image ? 'has-cover' : product.product_type==='course'?'cover-0':'cover-2' %>"><% if (product.cover_image) { %><img src="<%= product.cover_image %>" alt="<%= productTitle %>"><% } else { %><span class="cover-big-letter"><%= product.product_type==='course'?'C':'N' %></span><span class="cover-tag">Novingity / ENGINEERING</span><% } %><span class="cover-type"><%= product.product_type==='course'?t('home.shop.courseLabel'):t('home.shop.pluginLabel') %></span></div><div class="product-security"><span>✓</span><div><b><%= t('product.secureAccessTitle') %></b><small><%= t('product.secureAccessDesc') %></small></div></div></div><div class="product-detail-copy"><div class="product-category"><%= product.category ? categoryLabel(product.category, 'product.categoryFallback') : t('product.categoryFallback') %></div><h1><%= productTitle %></h1><p class="product-subtitle"><%= product.subtitle %></p><p class="product-description"><%= productShortDesc %></p><div class="product-detail-price"><small><%= t('product.priceLabel') %></small><strong><%= money(product.price_toman) %></strong></div>
<% if (owned) { %><a class="button button-primary button-large button-block" href="/account"><%= t('product.goToLibrary') %> ←</a><% } else if (currentUser) { %><form action="/checkout/<%= product.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary button-large button-block" type="submit"><%= t('product.buyNow') %> <span>←</span></button></form><% } else { %><a class="button button-primary button-large button-block" href="/login?next=<%= encodeURIComponent('/shop/' + product.slug) %>"><%= t('product.loginToBuy') %> <span aria-hidden="true">←</span></a><% } %>
<div class="purchase-note"><%= t('product.purchaseNote') %></div></div></div>
<div class="product-detail-lower"><div class="detail-main"><div class="detail-section-title"><span>01</span><h2><%= t('product.aboutTitle') %></h2></div><div class="prose"><% if (productDesc) { productDesc.split(/\r?\n/).filter(Boolean).forEach(line => { %><p><%= line %></p><% }); } else { %><p><%= productShortDesc || t('product.descriptionFallback') %></p><% } %></div>
<% if (gallery && gallery.length) { %>
<div class="detail-section-title"><span>02</span><h2><%= t('product.galleryTitle') %></h2></div>
<div class="plugin-gallery"><% gallery.forEach(g => { %><figure class="plugin-gallery-item"><a href="<%= g.image_path %>" target="_blank" rel="noopener" class="gallery-zoom" aria-label="<%= t('product.openImage') %>"><img src="<%= g.image_path %>" alt="<%= g.caption || productTitle %>" loading="lazy"></a><% if (g.caption) { %><figcaption><%= g.caption %></figcaption><% } %></figure><% }) %></div>
<% } %>
<% if (product.product_type === 'plugin' && ((product.usage_guide_intro || '').trim() || (demoSteps && demoSteps.length) || product.demo_video_url) ) { %>
<div class="detail-section-title"><span>03</span><h2><%= t('product.usageTitle') %></h2></div>
<% if ((product.usage_guide_intro || '').trim()) { %><div class="prose"><% product.usage_guide_intro.split(/\r?\n/).filter(Boolean).forEach(line => { %><p><%= line %></p><% }); %></div><% } %>
<% if (product.demo_video_url) { %><a class="button button-outline demo-video-link" href="<%= product.demo_video_url %>" target="_blank" rel="noopener noreferrer">▶ <%= t('product.watchDemo') %> ↗</a><% } %>
<% if (demoSteps && demoSteps.length) { %>
<ol class="demo-steps-list"><% demoSteps.forEach((s,i) => { %><li class="demo-step"><div class="demo-step-head"><span class="demo-step-num"><%= i+1 %></span><h3><%= s.title %></h3></div><% if (s.body) { %><p><%= s.body %></p><% } %><% const stepImages = s.images || (s.image_path ? [{ image_path: s.image_path, caption: '' }] : []); %><% if (stepImages.length) { %><div class="demo-step-images<%= stepImages.length > 1 ? ' is-multi' : '' %>"><% stepImages.forEach((im, k) => { %><a href="<%= im.image_path %>" target="_blank" rel="noopener" class="gallery-zoom" aria-label="<%= t('product.openImage') %>"><img src="<%= im.image_path %>" alt="<%= s.title %><%= stepImages.length > 1 ? ' — ' + (k + 1) : '' %>" loading="lazy"></a><% }) %></div><% } %></li><% }) %></ol>
<% } %>
<% } %>
</div><aside class="detail-aside"><div class="detail-section-title"><span>04</span><h2><%= product.product_type==='course'?t('product.curriculumTitle'):t('product.filesTitle') %></h2></div><% if (assets.length) { %><div class="asset-list"><% assets.forEach((a,i) => { %><div class="asset-row"><span class="asset-icon"><%= a.asset_kind==='video'?'▶':a.asset_kind==='pdf'?'▤':'↓' %></span><div><b><%= a.title %></b><small><%= a.asset_kind==='video'?t('product.assetVideo'):a.asset_kind==='pdf'?t('product.assetPdf'):a.asset_kind==='link'?t('product.assetLink'):t('product.assetDownload') %></small></div><% if (owned || a.is_preview || (currentAdmin && can('content'))) { %><a href="/secure-assets/<%= a.id %>" class="asset-action"><%= t('product.openAsset') %> ↗</a><% } else { %><span class="asset-lock">🔒</span><% } %></div><% }) %></div><% } else { %><div class="detail-placeholder"><p><%= t('product.contentPending') %></p></div><% } %></aside></div></div></section>
<%- include('partials/footer') %>
