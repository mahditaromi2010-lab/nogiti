<%- include('partials/header', {title}) %>
<% const productTitle = localizedField(product,'title','title_en'); const productShortDesc = localizedField(product,'short_description','short_description_en'); const productDesc = localizedField(product,'description','description_en'); %>
<section class="section product-detail-section"><div class="container"><div class="breadcrumb"><a href="/">خانه</a><span>/</span><a href="/shop">فروشگاه</a><span>/</span><span><%= productTitle %></span></div><div class="product-detail-grid"><div class="product-detail-visual"><div class="product-cover detail-cover <%= product.cover_image ? 'has-cover' : product.product_type==='course'?'cover-0':'cover-2' %>"><% if (product.cover_image) { %><img src="<%= product.cover_image %>" alt="تصویر <%= productTitle %>"><% } else { %><span class="cover-big-letter"><%= product.product_type==='course'?'C':'N' %></span><span class="cover-tag">Nogiti / ENGINEERING</span><% } %><span class="cover-type"><%= product.product_type==='course'?'دوره آموزشی':'افزونه اتوکد' %></span></div><div class="product-security"><span>✓</span><div><b>دسترسی امن پس از خرید</b><small>محتوای اختصاصی از حساب کاربری شما در دسترس است.</small></div></div></div><div class="product-detail-copy"><div class="product-category"><%= product.category || 'محصول تخصصی Nogiti' %></div><h1><%= productTitle %></h1><p class="product-subtitle"><%= product.subtitle %></p><p class="product-description"><%= productShortDesc %></p><div class="product-detail-price"><small>قیمت محصول</small><strong><%= money(product.price_toman) %></strong></div>
<% if (owned) { %><a class="button button-primary button-large button-block" href="/account">رفتن به کتابخانه من ←</a><% } else if (currentUser) { %><form action="/checkout/<%= product.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary button-large button-block" type="submit">خرید و دریافت دسترسی <span>←</span></button></form><% } else { %><a class="button button-primary button-large button-block" href="/login?next=<%= encodeURIComponent('/shop/' + product.slug) %>">ورود و ادامه خرید <span aria-hidden="true">←</span></a><% } %>
<div class="purchase-note">پرداخت فقط از طریق درگاه تنظیم‌شده انجام می‌شود. دسترسی خرید پس از تأیید سمت سرور فعال خواهد شد.</div></div></div>
<div class="product-detail-lower"><div class="detail-main"><div class="detail-section-title"><span>01</span><h2>درباره این محصول</h2></div><div class="prose"><% if (productDesc) { productDesc.split(/\r?\n/).filter(Boolean).forEach(line => { %><p><%= line %></p><% }); } else { %><p><%= productShortDesc || 'توضیحات تکمیلی این محصول به‌زودی منتشر می‌شود.' %></p><% } %></div></div><aside class="detail-aside"><div class="detail-section-title"><span>02</span><h2><%= product.product_type==='course'?'سرفصل‌ها و محتوا':'فایل‌های محصول' %></h2></div><% if (assets.length) { %><div class="asset-list"><% assets.forEach((a,i) => { %><div class="asset-row"><span class="asset-icon"><%= a.asset_kind==='video'?'▶':a.asset_kind==='pdf'?'▤':'↓' %></span><div><b><%= a.title %></b><small><%= a.asset_kind==='video'?'ویدئو آموزشی':a.asset_kind==='pdf'?'فایل PDF':a.asset_kind==='link'?'پیوند تکمیلی':'فایل دانلودی' %></small></div><% if (owned || a.is_preview || (currentAdmin && can('content'))) { %><a href="/secure-assets/<%= a.id %>" class="asset-action">بازکردن ↗</a><% } else { %><span class="asset-lock">🔒</span><% } %></div><% }) %></div><% } else { %><div class="detail-placeholder"><p>محتوای این محصول پس از تکمیل توسط تیم Nogiti نمایش داده می‌شود.</p></div><% } %></aside></div></div></section>
<%- include('partials/footer') %>
