<%- include('partials/header', {title}) %>
<% const articleTitle = localizedField(article,'title','title_en'); %>
<article class="article-page"><div class="container article-reading"><div class="breadcrumb"><a href="/"><%= t('tools.breadcrumbHome') %></a><span>/</span><a href="/articles"><%= t('articles.breadcrumbSelf') %></a><span>/</span><span><%= article.category %></span></div><div class="article-head"><span class="section-kicker"><%= article.category %></span><h1><%= articleTitle %></h1><p class="article-deck"><%= localizedField(article,'excerpt','excerpt_en') %></p><div class="article-byline"><span class="byline-avatar">N</span><span><b><%= t('article.byline') %></b><small><%= article.published_at ? new Date(article.published_at).toLocaleDateString(locale==='en'?'en-US':'fa-IR') : t('home.articles.categoryFallback') %></small></span></div></div>
<% if (article.cover_image) { %><div class="article-feature-image"><img src="<%= article.cover_image %>" alt="<%= articleTitle %>"></div><% } else { %><div class="article-feature-art"><span>Novingity / JOURNAL</span><b>ENGINEERING<br>KNOWLEDGE</b></div><% } %>
<div class="article-content-layout"><div class="article-body prose"><%- contentHtml %></div><aside class="article-aside"><div class="aside-card"><span class="section-kicker"><%= t('article.sideKicker') %></span><h3><%= t('article.sideTitle') %></h3><p><%= t('article.sideDesc') %></p><a href="/tools" class="text-link"><%= t('article.sideToolsLink') %> ←</a><a href="/shop" class="text-link"><%= t('article.sideCoursesLink') %> ←</a></div></aside></div><div class="article-back"><a href="/articles" class="button button-outline">← <%= t('article.backToAll') %></a></div></div></article>
<%- include('partials/footer') %>
