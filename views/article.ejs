<%- include('partials/header', {title}) %>
<% const articleTitle = localizedField(article,'title','title_en'); %>
<article class="article-page"><div class="container article-reading"><div class="breadcrumb"><a href="/">خانه</a><span>/</span><a href="/articles">مقالات</a><span>/</span><span><%= article.category %></span></div><div class="article-head"><span class="section-kicker"><%= article.category %></span><h1><%= articleTitle %></h1><p class="article-deck"><%= localizedField(article,'excerpt','excerpt_en') %></p><div class="article-byline"><span class="byline-avatar">N</span><span><b>تحریریه Nogiti</b><small><%= article.published_at ? new Date(article.published_at).toLocaleDateString('fa-IR') : 'مقاله تخصصی' %></small></span></div></div>
<% if (article.cover_image) { %><div class="article-feature-image"><img src="<%= article.cover_image %>" alt="<%= articleTitle %>"></div><% } else { %><div class="article-feature-art"><span>Nogiti / JOURNAL</span><b>ENGINEERING<br>KNOWLEDGE</b></div><% } %>
<div class="article-content-layout"><div class="article-body prose"><%- contentHtml %></div><aside class="article-aside"><div class="aside-card"><span class="section-kicker">در Nogiti</span><h3>دانش فنی را به عمل تبدیل کنید.</h3><p>از ابزارهای تأسیسات و دوره‌های آموزشی برای ادامهٔ مسیر استفاده کنید.</p><a href="/tools" class="text-link">ابزارهای مهندسی ←</a><a href="/shop" class="text-link">مشاهده دوره‌ها ←</a></div></aside></div><div class="article-back"><a href="/articles" class="button button-outline">← بازگشت به همه مقاله‌ها</a></div></div></article>
<%- include('partials/footer') %>
