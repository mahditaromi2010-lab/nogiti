<%- include('partials/header', {title}) %>
<section class="page-hero"><div class="container"><div class="breadcrumb"><a href="/"><%= t('tools.breadcrumbHome') %></a><span>/</span><span><%= t('about.breadcrumbSelf') %></span></div><span class="section-kicker"><%= t('kicker.about') %></span><h1><%= t('about.titlePre') %><br><em><%= t('about.titleEm') %></em></h1><p><%= t('about.lead') %></p></div></section>
<%- include('partials/flow-divider') %>
<section class="section reveal-on-scroll"><div class="container about-layout"><div class="about-statement"><span class="section-kicker"><%= t('about.approachKicker') %></span><h2><%= t('about.approachTitlePre') %><br><%= t('about.approachTitlePost') %></h2><p><%= (locale === 'en' ? settings.about_text_en : settings.about_text) || t('about.approachFallback') %></p></div><div class="about-values"><div class="value-row"><span>01</span><div><h3><%= t('about.value1Title') %></h3><p><%= t('about.value1Desc') %></p></div></div><div class="value-row"><span>02</span><div><h3><%= t('about.value2Title') %></h3><p><%= t('about.value2Desc') %></p></div></div><div class="value-row"><span>03</span><div><h3><%= t('about.value3Title') %></h3><p><%= t('about.value3Desc') %></p></div></div></div></div></section>
<section class="section section-team reveal-stagger"><div class="container"><div class="section-heading"><div><span class="section-kicker"><%= t('about.team.kicker') %></span><h2><%= t('about.team.heading') %></h2></div></div>
<% if (teamMembers && teamMembers.length) { %>
  <div class="team-grid"><% teamMembers.forEach(m => { %><div class="team-card reveal-item"><div class="team-photo <%= m.photo_path ? 'has-photo' : '' %>"><% if (m.photo_path) { %><img src="<%= m.photo_path %>" alt="<%= m.name %>" loading="lazy"><% } else { %><span><%= m.name.slice(0,1) %></span><% } %></div><h3><%= m.name %></h3><% if (m.role) { %><div class="team-role"><%= m.role %></div><% } %><% if (m.bio) { %><p><%= m.bio %></p><% } %><% if (m.link_url) { %><a class="text-link" href="<%= m.link_url %>" target="_blank" rel="noopener noreferrer"><%= t('about.viewProfile') %> <span>←</span></a><% } %></div><% }) %></div>
<% } else { %>
  <div class="empty-state empty-compact"><span>☺</span><h3><%= t('about.teamEmptyTitle') %></h3><p><%= t('about.teamEmptyDesc') %></p></div>
<% } %>
</div></section>
<section class="contact-band"><div class="container contact-inner"><div><span class="section-kicker kicker-light"><%= t('about.contactKicker') %></span><h2><%= t('about.contactTitle') %></h2></div><div class="contact-details"><a href="mailto:<%= settings.contact_email || 'nugasbnd@gmail.com' %>"><span><%= t('about.contactEmail') %></span><b><%= settings.contact_email || 'nugasbnd@gmail.com' %></b></a><a href="tel:<%= settings.contact_phone || '09033998344' %>"><span><%= t('about.contactPhone') %></span><b><%= settings.contact_phone || '09033998344' %></b></a><div><span><%= t('about.contactInstagram') %></span><b><%= settings.instagram || '@nugas_bnd' %></b></div></div></div></section>
<%- include('partials/footer') %>
