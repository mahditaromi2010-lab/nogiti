<%- include('partials/header', {title}) %>
<section class="page-hero"><div class="container"><div class="breadcrumb"><a href="/">خانه</a><span>/</span><span>درباره ما</span></div><span class="section-kicker">ABOUT Nogiti</span><h1>مهندسی دقیق‌تر،<br><em>با دسترسی بهتر به دانش.</em></h1><p>Nogiti برای پیوند ابزارهای مهندسی، آموزش‌های تخصصی و تجربهٔ کاربردی در پروژه‌های تأسیساتی شکل گرفته است.</p></div></section>
<section class="section"><div class="container about-layout"><div class="about-statement"><span class="section-kicker">رویکرد ما</span><h2>ابزار باید مسئله را ساده کند؛<br>نه اینکه خودش مسئله‌ای تازه باشد.</h2><p><%= settings.about_text || 'Nogiti بستری برای دسترسی به ابزارهای تخصصی تأسیسات، آموزش مهندسی و منابع کاربردی است.' %></p></div><div class="about-values"><div class="value-row"><span>01</span><div><h3>کاربردی بودن</h3><p>دسترسی ساده به ابزارها و محتوایی که در مسیر واقعی طراحی و اجرا کمک می‌کنند.</p></div></div><div class="value-row"><span>02</span><div><h3>یادگیری مستمر</h3><p>ساختن فضایی برای آموزش مرحله‌به‌مرحله و نگهداری منابع در حساب کاربری.</p></div></div><div class="value-row"><span>03</span><div><h3>شفافیت</h3><p>توضیح روشن خدمات، قیمت‌ها و وضعیت سفارش‌ها در فرایند استفاده از سایت.</p></div></div></div></div></section>
<% if (teamMembers && teamMembers.length) { %>
<section class="section section-team"><div class="container"><div class="section-heading"><div><span class="section-kicker"><%= t('about.team.kicker') %></span><h2><%= t('about.team.heading') %></h2></div></div>
  <div class="team-grid"><% teamMembers.forEach(m => { %><div class="team-card"><div class="team-photo <%= m.photo_path ? 'has-photo' : '' %>"><% if (m.photo_path) { %><img src="<%= m.photo_path %>" alt="<%= m.name %>" loading="lazy"><% } else { %><span><%= m.name.slice(0,1) %></span><% } %></div><h3><%= m.name %></h3><% if (m.role) { %><div class="team-role"><%= m.role %></div><% } %><% if (m.bio) { %><p><%= m.bio %></p><% } %><% if (m.link_url) { %><a class="text-link" href="<%= m.link_url %>" target="_blank" rel="noopener noreferrer">مشاهده پروفایل <span>←</span></a><% } %></div><% }) %></div>
</div></section>
<% } %>
<section class="contact-band"><div class="container contact-inner"><div><span class="section-kicker kicker-light">با ما در ارتباط باشید</span><h2>برای پرسش یا همکاری، در تماس باشید.</h2></div><div class="contact-details"><a href="mailto:<%= settings.contact_email || 'nugasbnd@gmail.com' %>"><span>ایمیل</span><b><%= settings.contact_email || 'nugasbnd@gmail.com' %></b></a><a href="tel:<%= settings.contact_phone || '09033998344' %>"><span>تماس</span><b><%= settings.contact_phone || '09033998344' %></b></a><div><span>اینستاگرام</span><b><%= settings.instagram || '@nugas_bnd' %></b></div></div></div></section>
<%- include('partials/footer') %>
