<%- include('partials/header', {title}) %>
<section class="page-hero article-hero"><div class="container"><div class="breadcrumb"><a href="/">خانه</a><span>/</span><span>مقالات</span></div><span class="section-kicker">THE Nogiti JOURNAL</span><h1>دانش مهندسی،<br><em>قابل استفاده در پروژه.</em></h1><p>مطالب فنی، راهنماها و نکته‌های کاربردی دربارهٔ تأسیسات و ابزارهای مهندسی.</p><form method="get" action="/articles" class="article-search"><span>⌕</span><input name="q" value="<%= q %>" placeholder="جست‌وجو در مقالات..."><button type="submit">جست‌وجو</button></form></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="section-kicker">محتوای تخصصی</span><h2><%= q ? 'نتایج جست‌وجو' : 'آخرین مقاله‌ها' %></h2><p>مقاله‌ها همراه با تصویر شاخص، دسته‌بندی و توضیح کوتاه.</p></div><span class="results-count"><%= articles.length %> مقاله</span></div>
<% if (articles.length) { %><div class="article-grid article-grid-wide"><% articles.forEach((a, i) => { %><% const aTitle = localizedField(a,'title','title_en'); %><a href="/articles/<%= a.slug %>" class="article-card"><div class="article-image"><% if (a.cover_image) { %><img src="<%= a.cover_image %>" alt="<%= aTitle %>" loading="lazy"><% } else { %><div class="article-art art-<%= i%3 %>"><span>NG / <%= String(i+1).padStart(2,'0') %></span><b>ENGINEERING<br>JOURNAL</b></div><% } %></div><div class="article-copy"><div class="article-meta"><span><%= a.category %></span><span><%= a.published_at ? new Date(a.published_at).toLocaleDateString('fa-IR') : 'مقاله تخصصی' %></span></div><h3><%= aTitle %></h3><p><%= localizedField(a,'excerpt','excerpt_en') %></p><span class="article-read">ادامه مقاله <span>←</span></span></div></a><% }) %></div><% } else { %><div class="empty-state"><span>▧</span><h3>مقاله‌ای برای نمایش نیست</h3><p>جست‌وجوی دیگری امتحان کنید یا بعداً دوباره سر بزنید.</p></div><% } %>
</div></section>
<%- include('partials/footer') %>
