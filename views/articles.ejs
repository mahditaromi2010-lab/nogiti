<%- include('partials/header', {title}) %>
<section class="page-hero article-hero"><div class="container"><div class="breadcrumb"><a href="/"><%= t('tools.breadcrumbHome') %></a><span>/</span><span><%= t('articles.breadcrumbSelf') %></span></div><span class="section-kicker">THE Novingity JOURNAL</span><h1><%= t('articles.titlePre') %><br><em><%= t('articles.titleEm') %></em></h1><p><%= t('articles.lead') %></p><form method="get" action="/articles" class="article-search"><span>⌕</span><input name="q" value="<%= q %>" placeholder="<%= t('articles.searchPlaceholder') %>"><button type="submit"><%= t('shop.searchSubmit') %></button></form></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="section-kicker"><%= t('articles.kicker') %></span><h2><%= q ? t('articles.searchResults') : t('articles.latest') %></h2><p><%= t('articles.sub') %></p></div><span class="results-count"><%= articles.length %> <%= articles.length === 1 ? t('articles.countSingular') : t('articles.countPlural') %></span></div>
<% if (articles.length) { %><div class="article-grid article-grid-wide"><% articles.forEach((a, i) => { %><% const aTitle = localizedField(a,'title','title_en'); %><a href="/articles/<%= a.slug %>" class="article-card"><div class="article-image"><% if (a.cover_image) { %><img src="<%= a.cover_image %>" alt="<%= aTitle %>" loading="lazy"><% } else { %><div class="article-art art-<%= i%3 %>"><span>NG / <%= String(i+1).padStart(2,'0') %></span><b>ENGINEERING<br>JOURNAL</b></div><% } %></div><div class="article-copy"><div class="article-meta"><span><%= categoryLabel(a.category) %></span><span><%= a.published_at ? new Date(a.published_at).toLocaleDateString(locale==='en'?'en-US':'fa-IR') : t('home.articles.categoryFallback') %></span></div><h3><%= aTitle %></h3><p><%= localizedField(a,'excerpt','excerpt_en') %></p><span class="article-read"><%= t('articles.continueReading') %> <span>←</span></span></div></a><% }) %></div><% } else { %><div class="empty-state"><span>▧</span><h3><%= t('articles.emptyTitle') %></h3><p><%= t('articles.emptyDesc') %></p></div><% } %>
</div></section>
<%- include('partials/footer') %>
