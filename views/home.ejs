<%- include('partials/header', {title}) %>
<section class="hero-section">
  <div class="hero-grid container">
    <div class="hero-copy">
      <div class="eyebrow"><span class="eyebrow-dot"></span> <%= t('home.hero.eyebrow') %></div>
      <h1><span class="h1-line"><%= t('home.hero.titlePre') %></span> <em class="h1-line"><%= t('home.hero.titleEm') %></em></h1>
      <p class="hero-lead"><%= t('home.hero.lead') %></p>
      <div class="hero-actions"><a class="button button-primary button-large" href="/tools"><%= t('home.hero.ctaPrimary') %> <span>←</span></a><a class="button button-outline button-large" href="/shop"><%= t('home.hero.ctaSecondary') %></a></div>
      <div class="hero-trust"><span class="trust-check">✓</span> <%= t('home.hero.trustLeft') %> <span class="trust-separator">•</span> <%= t('home.hero.trustRight') %></div>
    </div>
    <div class="hero-visual">
      <%# Signature moment: an isometric gas-installation drawing (supply, riser, valve, meter, branches to a
          water heater, cooker and space heater) that draws itself, ignites, then shows gas flowing. Pure SVG +
          CSS (public/css/elevate.css, "gas-sheet"); motion.js only pauses it off-screen. Static when the
          visitor prefers reduced motion. %>
      <svg class="gas-sheet" viewBox="0 0 560 450" focusable="false" aria-hidden="true">
        <g class="gs-geo">
          <path class="gs-ground" d="M150 412 H548"/>
          <path class="gs-hatch" d="M160 412 l-10 10 M190 412 l-10 10 M220 412 l-10 10 M250 412 l-10 10 M280 412 l-10 10 M310 412 l-10 10 M340 412 l-10 10 M370 412 l-10 10 M400 412 l-10 10 M430 412 l-10 10 M460 412 l-10 10 M490 412 l-10 10 M520 412 l-10 10"/>
          <g class="gs-pipes">
            <path class="gs-pipe" style="--d:0" pathLength="1" d="M560 384 H470 V210"/>
            <path class="gs-pipe" style="--d:1" pathLength="1" d="M440 176 H408 L200 296 V318"/>
            <path class="gs-pipe" style="--d:2" pathLength="1" d="M304 236 V296"/>
            <path class="gs-pipe" style="--d:2" pathLength="1" d="M372 197 V352"/>
          </g>
          <g class="gs-flow">
            <path pathLength="1" d="M560 384 H470 V210"/>
            <path pathLength="1" d="M440 176 H408 L200 296 V318"/>
            <path pathLength="1" d="M304 236 V296"/>
            <path pathLength="1" d="M372 197 V352"/>
          </g>
          <g class="gs-parts">
            <path class="gs-valve" d="M458 290 L482 310 V290 L458 310 Z"/>
            <path class="gs-stem" d="M470 300 V284 M462 284 H478"/>
            <rect class="gs-box gs-meter" x="440" y="142" width="60" height="68" rx="6"/>
            <circle class="gs-dial" cx="470" cy="168" r="12"/>
            <path class="gs-needle" d="M470 168 L478 161"/>
            <rect class="gs-box" x="176" y="318" width="48" height="94" rx="6"/>
            <rect class="gs-window" x="188" y="384" width="24" height="16" rx="3"/>
            <rect class="gs-box" x="268" y="296" width="72" height="46" rx="4"/>
            <path class="gs-detail" d="M276 320 H332 M282 332 h8 M300 332 h8 M318 332 h8"/>
            <rect class="gs-box" x="344" y="352" width="56" height="44" rx="4"/>
            <path class="gs-detail" d="M352 362 H392 M352 370 H392 M352 378 H392"/>
            <path class="gs-dim" d="M440 128 H500 M440 122 V134 M500 122 V134"/>
          </g>
          <g class="gs-flames">
            <path style="--f:0" d="M200 398 c-5 -5 -4 -11 0 -15 c4 4 5 10 0 15 Z"/>
            <path style="--f:1" d="M288 294 c-5 -5 -4 -11 0 -15 c4 4 5 10 0 15 Z"/>
            <path style="--f:2" d="M320 294 c-5 -5 -4 -11 0 -15 c4 4 5 10 0 15 Z"/>
            <path style="--f:1" d="M372 392 c-4 -4 -3 -9 0 -12 c3 3 4 8 0 12 Z"/>
          </g>
          <g class="gs-labels">
            <text x="470" y="200">G4</text>
            <text x="470" y="116">15.5 cm</text>
            <text x="318" y="204" class="gs-label-slope">Ø 1″</text>
            <text x="522" y="372">P = ¼ psi</text>
          </g>
        </g>
      </svg>
      <a class="gs-meter-link" href="/tools#meter" aria-label="<%= t('home.tools.card4Title') %>"></a>
      <div class="gs-callout gs-callout-top"><b><%= t('home.hero.noteTopTitle') %></b><small><%= t('home.hero.noteTopSub') %></small></div>
      <div class="gs-callout gs-callout-bottom"><b><%= t('home.hero.noteBottomTitle') %></b><small><%= t('home.hero.noteBottomSub') %></small></div>
      <div class="gs-titleblock"><span><%= t('home.hero.metricLabel') %></span><strong><%= t('home.hero.metricValue') %></strong><span class="gs-tb-sheet">NG-01</span></div>
    </div>
  </div>
  <div class="hero-bottom-line"><div class="container hero-bottom-content"><span><%= t('home.hero.bottomLine1') %></span><span><%= t('home.hero.bottomLine2') %></span><span><%= t('home.hero.bottomLine3') %></span><span><%= t('home.hero.bottomLine4') %></span></div></div>
</section>
<%- include('partials/flow-divider') %>
<section class="section section-tools"><div class="container"><div class="section-heading"><div><span class="section-kicker"><%= t('home.tools.kicker') %></span><h2><%= t('home.tools.heading') %></h2><p><%= t('home.tools.sub') %></p></div><a class="text-link" href="/tools"><%= t('home.tools.viewAll') %> <span>←</span></a></div>
  <div class="tool-grid reveal-stagger"><a href="/tools#vent" class="tool-card reveal-item"><span class="tool-icon icon-teal"><%- include('partials/tool-icon', { name: 'air' }) %></span><h3><%= t('home.tools.card1Title') %></h3><p><%= t('home.tools.card1Desc') %></p><span class="card-arrow">←</span></a><a href="/tools#pipe" class="tool-card reveal-item"><span class="tool-icon icon-blue"><%- include('partials/tool-icon', { name: 'pipe' }) %></span><h3><%= t('home.tools.card2Title') %></h3><p><%= t('home.tools.card2Desc') %></p><span class="card-arrow">←</span></a><a href="/tools#chimney" class="tool-card reveal-item"><span class="tool-icon icon-gold"><%- include('partials/tool-icon', { name: 'flue' }) %></span><h3><%= t('home.tools.card3Title') %></h3><p><%= t('home.tools.card3Desc') %></p><span class="card-arrow">←</span></a><a href="/tools#meter" class="tool-card reveal-item"><span class="tool-icon icon-purple"><%- include('partials/tool-icon', { name: 'meter' }) %></span><h3><%= t('home.tools.card4Title') %></h3><p><%= t('home.tools.card4Desc') %></p><span class="card-arrow">←</span></a></div>
  <div class="notice-strip"><span class="notice-icon">i</span><p><%= t('home.tools.notice') %></p><a href="/tools"><%= t('home.tools.noticeCta') %> <span>←</span></a></div>
</div></section>
<section class="section section-shop"><div class="container"><div class="section-heading"><div><span class="section-kicker"><%= t('home.shop.kicker') %></span><h2><%= t('home.shop.heading') %></h2><p><%= t('home.shop.sub') %></p></div><a class="text-link" href="/shop"><%= t('home.shop.viewAll') %> <span>←</span></a></div>
  <% if (products.length) { %><div class="product-grid reveal-stagger"><% products.forEach((p, i) => { %><% const pTitle = localizedField(p,'title','title_en'); %><a class="product-card reveal-item" href="/shop/<%= p.slug %>"><div class="product-cover <%= p.cover_image ? 'has-cover' : 'cover-'+(i%3) %>"><% if (p.cover_image) { %><img src="<%= p.cover_image %>" alt="<%= pTitle %>" loading="lazy"><% } else { %><span class="cover-big-letter"><%= p.product_type === 'course' ? 'C' : 'N' %></span><span class="cover-tag"><%= p.product_type === 'course' ? 'Novingity ACADEMY' : 'Novingity TOOLS' %></span><% } %><span class="cover-type"><%= p.product_type === 'course' ? t('home.shop.courseLabel') : t('home.shop.pluginLabel') %></span></div><div class="product-body"><div class="product-category"><%= p.category ? categoryLabel(p.category, 'home.shop.categoryFallback') : t('home.shop.categoryFallback') %></div><h3><%= pTitle %></h3><p><%= localizedField(p,'short_description','short_description_en') %></p><div class="product-meta"><strong><%= money(p.price_toman) %></strong><span><%= t('home.shop.viewDetails') %> ↗</span></div></div></a><% }) %></div><% } else { %><div class="empty-state"><span>▤</span><h3><%= t('home.shop.emptyTitle') %></h3><p><%= t('home.shop.emptyDesc') %></p><a class="button button-outline" href="/shop"><%= t('home.shop.emptyCta') %></a></div><% } %>
</div></section>
<section class="section section-articles"><div class="container"><div class="section-heading"><div><span class="section-kicker"><%= t('home.articles.kicker') %></span><h2><%= t('home.articles.heading') %></h2><p><%= t('home.articles.sub') %></p></div><a class="text-link" href="/articles"><%= t('home.articles.viewAll') %> <span>←</span></a></div>
  <% if (articles.length) { %><div class="article-grid reveal-stagger"><% articles.forEach((a, i) => { %><% const aTitle = localizedField(a,'title','title_en'); %><a href="/articles/<%= a.slug %>" class="article-card reveal-item"><div class="article-image"><% if (a.cover_image) { %><img src="<%= a.cover_image %>" alt="<%= aTitle %>" loading="lazy"><% } else { %><div class="article-art art-<%= i%3 %>"><span>NG / <%= String(i+1).padStart(2,'0') %></span><b>ENGINEERING<br>JOURNAL</b></div><% } %></div><div class="article-copy"><div class="article-meta"><span><%= categoryLabel(a.category) %></span><span><%= a.published_at ? new Date(a.published_at).toLocaleDateString(locale==='en'?'en-US':'fa-IR') : t('home.articles.categoryFallback') %></span></div><h3><%= aTitle %></h3><p><%= localizedField(a,'excerpt','excerpt_en') %></p><span class="article-read"><%= t('home.articles.readMore') %> <span>←</span></span></div></a><% }) %></div><% } else { %><div class="empty-state empty-light"><span>▧</span><h3><%= t('home.articles.emptyTitle') %></h3><p><%= t('home.articles.emptyDesc') %></p></div><% } %>
</div></section>
<section class="cta-section"><div class="container cta-inner"><div><span class="section-kicker kicker-light"><%= t('home.cta.kicker') %></span><h2><%= t('home.cta.headingPre') %><br><%= t('home.cta.headingPost') %></h2><p><%= t('home.cta.sub') %></p></div><a class="button button-light button-large" href="/login"><%= t('home.cta.action') %> <span>←</span></a></div></section>
<%- include('partials/footer') %>
