<%- include('partials/header', {title}) %>
<section class="hero-section">
  <div class="hero-grid container">
    <div class="hero-copy">
      <div class="eyebrow"><span class="eyebrow-dot"></span> پلتفرم مهندسی و آموزش تخصصی</div>
      <h1>از محاسبه تا اجرا،<br><em>با اطمینان مهندسی کنید.</em></h1>
      <p class="hero-lead">ابزارهای تخصصی تأسیسات، آموزش‌های کاربردی و افزونه‌های حرفه‌ای اتوکد؛ برای تصمیم‌هایی دقیق‌تر در هر پروژه.</p>
      <div class="hero-actions"><a class="button button-primary button-large" href="/tools">شروع محاسبه <span>←</span></a><a class="button button-outline button-large" href="/shop">مشاهده فروشگاه</a></div>
      <div class="hero-trust"><span class="trust-check">✓</span> دسترسی ساده به ابزارهای تخصصی <span class="trust-separator">•</span> محتوا و محصولات متمرکز</div>
    </div>
    <div class="hero-visual" aria-label="نمای گرافیکی ابزارهای مهندسی">
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
      <div class="engineering-card card-main"><div class="card-topline"><span>ENGINEERING TOOLS</span><span class="live-dot"></span></div><div class="blueprint-icon"><svg viewBox="0 0 240 190" role="img" aria-label="طرح شماتیک مهندسی"><g fill="none" stroke="currentColor" stroke-width="1.4"><path d="M22 32h196v126H22z" stroke-dasharray="4 5" opacity=".35"/><path d="M50 130V56h52v74M102 78h40v52M142 100h48v30M50 56l26-20 26 20M102 130h88"/><circle cx="76" cy="130" r="5"/><circle cx="166" cy="130" r="5"/><path d="M42 145h62M119 145h62M35 45h25M145 50h42" opacity=".6"/></g><g fill="currentColor" font-size="9"><text x="47" y="153">AIR FLOW</text><text x="132" y="65">PIPE</text><text x="167" y="91">Ø 25</text></g></svg></div><div class="metrics-row"><div><small>دقت و نظم</small><strong>محاسبات مهندسی</strong></div><span class="metric-icon">⌁</span></div></div>
      <div class="floating-note note-top"><span class="note-symbol">⌘</span><span><b>ابزارهای تخصصی</b><small>محاسبه در چند مرحله</small></span></div>
      <div class="floating-note note-bottom"><span class="note-symbol note-gold">▶</span><span><b>یادگیری هدفمند</b><small>دوره‌ها و منابع کاربردی</small></span></div>
      <div class="hero-spark spark-a">✳</div><div class="hero-spark spark-b">＋</div>
    </div>
  </div>
  <div class="hero-bottom-line"><div class="container hero-bottom-content"><span>محاسبات تأسیسات</span><span>آموزش مهندسی</span><span>افزونه‌های اتوکد</span><span>دانش فنی و مقالات</span></div></div>
</section>
<section class="section section-tools"><div class="container"><div class="section-heading"><div><span class="section-kicker">ابزارهای در دسترس</span><h2>محاسبات مهم، در یک مسیر ساده</h2><p>برای شروع کار، ابزار مورد نیازتان را انتخاب کنید.</p></div><a class="text-link" href="/tools">همه ابزارها <span>←</span></a></div>
  <div class="tool-grid"><a href="/tools#vent" class="tool-card"><span class="tool-icon icon-teal">↗</span><span class="tool-index">01 / AIR</span><h3>تأمین هوای احتراق</h3><p>بررسی حجم فضا و برآورد ابعاد مسیر تأمین هوا.</p><span class="card-arrow">←</span></a><a href="/tools#pipe" class="tool-card"><span class="tool-icon icon-blue">⌁</span><span class="tool-index">02 / PIPE</span><h3>قطر لوله گاز</h3><p>برآورد اولیه بر اساس طول مسیر و مصرف گاز.</p><span class="card-arrow">←</span></a><a href="/tools#chimney" class="tool-card"><span class="tool-icon icon-gold">⌇</span><span class="tool-index">03 / FLUE</span><h3>قطر دودکش</h3><p>انتخاب اولیه با توجه به ارتفاع و لوله رابط.</p><span class="card-arrow">←</span></a><a href="/tools#meter" class="tool-card"><span class="tool-icon icon-purple">◉</span><span class="tool-index">04 / METER</span><h3>مشخصات کنتور</h3><p>دریافت اطلاعات اولیه متناسب با مصرف ساختمان.</p><span class="card-arrow">←</span></a></div>
  <div class="notice-strip"><span class="notice-icon">i</span><p>خروجی ابزارها برای برآورد اولیه است و جایگزین کنترل مقررات، جدول‌های رسمی و تأیید مهندس مسئول پروژه نیست.</p><a href="/tools">شروع کار <span>←</span></a></div>
</div></section>
<section class="section section-shop"><div class="container"><div class="section-heading"><div><span class="section-kicker">یادگیری و ابزار حرفه‌ای</span><h2>برای گام بعدی آماده شوید</h2><p>دوره‌های آموزشی و افزونه‌هایی که کار روزمره را ساده‌تر می‌کنند.</p></div><a class="text-link" href="/shop">رفتن به فروشگاه <span>←</span></a></div>
  <% if (products.length) { %><div class="product-grid"><% products.forEach((p, i) => { %><% const pTitle = localizedField(p,'title','title_en'); %><a class="product-card" href="/shop/<%= p.slug %>"><div class="product-cover <%= p.cover_image ? 'has-cover' : 'cover-'+(i%3) %>"><% if (p.cover_image) { %><img src="<%= p.cover_image %>" alt="تصویر <%= pTitle %>" loading="lazy"><% } else { %><span class="cover-big-letter"><%= p.product_type === 'course' ? 'C' : 'N' %></span><span class="cover-tag"><%= p.product_type === 'course' ? 'Nogiti ACADEMY' : 'Nogiti TOOLS' %></span><% } %><span class="cover-type"><%= p.product_type === 'course' ? 'دوره آموزشی' : 'افزونه اتوکد' %></span></div><div class="product-body"><div class="product-category"><%= p.category || 'تخصصی' %></div><h3><%= pTitle %></h3><p><%= localizedField(p,'short_description','short_description_en') %></p><div class="product-meta"><strong><%= money(p.price_toman) %></strong><span>مشاهده جزئیات ↗</span></div></div></a><% }) %></div><% } else { %><div class="empty-state"><span>▤</span><h3>فروشگاه در حال آماده‌سازی است</h3><p>به‌زودی دوره‌ها و افزونه‌های Nogiti در این بخش قرار می‌گیرند.</p><a class="button button-outline" href="/shop">مشاهده فروشگاه</a></div><% } %>
</div></section>
<section class="section section-articles"><div class="container"><div class="section-heading"><div><span class="section-kicker">مجله Nogiti</span><h2>دانش فنی، با زبان کاربردی</h2><p>مقاله‌هایی برای تصمیم‌گیری بهتر در طراحی و اجرای پروژه‌ها.</p></div><a class="text-link" href="/articles">همه مقالات <span>←</span></a></div>
  <% if (articles.length) { %><div class="article-grid"><% articles.forEach((a, i) => { %><% const aTitle = localizedField(a,'title','title_en'); %><a href="/articles/<%= a.slug %>" class="article-card"><div class="article-image"><% if (a.cover_image) { %><img src="<%= a.cover_image %>" alt="<%= aTitle %>" loading="lazy"><% } else { %><div class="article-art art-<%= i%3 %>"><span>NG / <%= String(i+1).padStart(2,'0') %></span><b>ENGINEERING<br>JOURNAL</b></div><% } %></div><div class="article-copy"><div class="article-meta"><span><%= a.category %></span><span><%= a.published_at ? new Date(a.published_at).toLocaleDateString('fa-IR') : 'مقاله تخصصی' %></span></div><h3><%= aTitle %></h3><p><%= localizedField(a,'excerpt','excerpt_en') %></p><span class="article-read">مطالعه مقاله <span>←</span></span></div></a><% }) %></div><% } else { %><div class="empty-state empty-light"><span>▧</span><h3>مقاله‌های تخصصی به‌زودی منتشر می‌شوند</h3><p>در این مجله، مقالات فنی همراه با تصویر و دسته‌بندی نمایش داده خواهند شد.</p></div><% } %>
</div></section>
<section class="cta-section"><div class="container cta-inner"><div><span class="section-kicker kicker-light">Nogiti / YOUR WORKSPACE</span><h2>ابزارها و آموزش‌های مورد نیازتان<br>را همیشه در دسترس داشته باشید.</h2><p>حساب کاربری بسازید تا سفارش‌ها و محتوای آموزشی خریداری‌شده در یک کتابخانه جمع شوند.</p></div><a class="button button-light button-large" href="/login">ورود به حساب کاربری <span>←</span></a></div></section>
<%- include('partials/footer') %>
