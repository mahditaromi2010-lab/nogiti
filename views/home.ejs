<%- include('partials/header', {title}) %>
<section class="hero-section">
  <div class="hero-grid container">
    <div class="hero-copy">
      <div class="eyebrow"><span class="eyebrow-dot"></span> <%= t('home.hero.eyebrow') %></div>
      <h1><%= t('home.hero.titlePre') %><br><em><%= t('home.hero.titleEm') %></em></h1>
      <p class="hero-lead"><%= t('home.hero.lead') %></p>
      <div class="hero-actions"><a class="button button-primary button-large" href="/tools"><%= t('home.hero.ctaPrimary') %> <span>←</span></a><a class="button button-outline button-large" href="/shop"><%= t('home.hero.ctaSecondary') %></a></div>
      <div class="hero-trust"><span class="trust-check">✓</span> <%= t('home.hero.trustLeft') %> <span class="trust-separator">•</span> <%= t('home.hero.trustRight') %></div>
    </div>
    <div class="hero-visual" aria-label="<%= t('home.hero.visualAlt') %>">
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
      <div class="engineering-card card-main"><div class="card-topline"><span>ENGINEERING TOOLS</span><span class="live-dot"></span></div><div class="blueprint-icon"><svg viewBox="0 0 240 190" role="img" aria-label="<%= t('home.hero.blueprintAlt') %>"><g fill="none" stroke="currentColor" stroke-width="1.4"><path d="M22 32h196v126H22z" stroke-dasharray="4 5" opacity=".35"/><path d="M50 130V56h52v74M102 78h40v52M142 100h48v30M50 56l26-20 26 20M102 130h88"/><circle cx="76" cy="130" r="5"/><circle cx="166" cy="130" r="5"/><path d="M42 145h62M119 145h62M35 45h25M145 50h42" opacity=".6"/></g><g fill="currentColor" font-size="9"><text x="47" y="153">AIR FLOW</text><text x="132" y="65">PIPE</text><text x="167" y="91">Ø 25</text></g></svg></div><div class="metrics-row"><div><small><%= t('home.hero.metricLabel') %></small><strong><%= t('home.hero.metricValue') %></strong></div><span class="metric-icon">⌁</span></div></div>
      <div class="floating-note note-top"><span class="note-symbol">⌘</span><span><b><%= t('home.hero.noteTopTitle') %></b><small><%= t('home.hero.noteTopSub') %></small></span></div>
      <div class="floating-note note-bottom"><span class="note-symbol note-gold">▶</span><span><b><%= t('home.hero.noteBottomTitle') %></b><small><%= t('home.hero.noteBottomSub') %></small></span></div>
      <div class="hero-spark spark-a">✳</div><div class="hero-spark spark-b">＋</div>
    </div>
  </div>
  <div class="hero-bottom-line"><div class="container hero-bottom-content"><span><%= t('home.hero.bottomLine1') %></span><span><%= t('home.hero.bottomLine2') %></span><span><%= t('home.hero.bottomLine3') %></span><span><%= t('home.hero.bottomLine4') %></span></div></div>
</section>
<%- include('partials/flow-divider') %>
<section class="section section-tools"><div class="container"><div class="section-heading"><div><span class="section-kicker"><%= t('home.tools.kicker') %></span><h2><%= t('home.tools.heading') %></h2><p><%= t('home.tools.sub') %></p></div><a class="text-link" href="/tools"><%= t('home.tools.viewAll') %> <span>←</span></a></div>
  <div class="tool-grid reveal-stagger"><a href="/tools#vent" class="tool-card reveal-item"><span class="tool-icon icon-teal">↗</span><span class="tool-index">01 / AIR</span><h3><%= t('home.tools.card1Title') %></h3><p><%= t('home.tools.card1Desc') %></p><span class="card-arrow">←</span></a><a href="/tools#pipe" class="tool-card reveal-item"><span class="tool-icon icon-blue">⌁</span><span class="tool-index">02 / PIPE</span><h3><%= t('home.tools.card2Title') %></h3><p><%= t('home.tools.card2Desc') %></p><span class="card-arrow">←</span></a><a href="/tools#chimney" class="tool-card reveal-item"><span class="tool-icon icon-gold">⌇</span><span class="tool-index">03 / FLUE</span><h3><%= t('home.tools.card3Title') %></h3><p><%= t('home.tools.card3Desc') %></p><span class="card-arrow">←</span></a><a href="/tools#meter" class="tool-card reveal-item"><span class="tool-icon icon-purple">◉</span><span class="tool-index">04 / METER</span><h3><%= t('home.tools.card4Title') %></h3><p><%= t('home.tools.card4Desc') %></p><span class="card-arrow">←</span></a></div>
  <div class="notice-strip"><span class="notice-icon">i</span><p><%= t('home.tools.notice') %></p><a href="/tools"><%= t('home.tools.noticeCta') %> <span>←</span></a></div>
</div></section>
<section class="section section-shop"><div class="container"><div class="section-heading"><div><span class="section-kicker"><%= t('home.shop.kicker') %></span><h2><%= t('home.shop.heading') %></h2><p><%= t('home.shop.sub') %></p></div><a class="text-link" href="/shop"><%= t('home.shop.viewAll') %> <span>←</span></a></div>
  <% if (products.length) { %><div class="product-grid reveal-stagger"><% products.forEach((p, i) => { %><% const pTitle = localizedField(p,'title','title_en'); %><a class="product-card reveal-item" href="/shop/<%= p.slug %>"><div class="product-cover <%= p.cover_image ? 'has-cover' : 'cover-'+(i%3) %>"><% if (p.cover_image) { %><img src="<%= p.cover_image %>" alt="<%= pTitle %>" loading="lazy"><% } else { %><span class="cover-big-letter"><%= p.product_type === 'course' ? 'C' : 'N' %></span><span class="cover-tag"><%= p.product_type === 'course' ? 'Novingity ACADEMY' : 'Novingity TOOLS' %></span><% } %><span class="cover-type"><%= p.product_type === 'course' ? t('home.shop.courseLabel') : t('home.shop.pluginLabel') %></span></div><div class="product-body"><div class="product-category"><%= p.category ? categoryLabel(p.category, 'home.shop.categoryFallback') : t('home.shop.categoryFallback') %></div><h3><%= pTitle %></h3><p><%= localizedField(p,'short_description','short_description_en') %></p><div class="product-meta"><strong><%= money(p.price_toman) %></strong><span><%= t('home.shop.viewDetails') %> ↗</span></div></div></a><% }) %></div><% } else { %><div class="empty-state"><span>▤</span><h3><%= t('home.shop.emptyTitle') %></h3><p><%= t('home.shop.emptyDesc') %></p><a class="button button-outline" href="/shop"><%= t('home.shop.emptyCta') %></a></div><% } %>
</div></section>
<section class="section section-articles"><div class="container"><div class="section-heading"><div><span class="section-kicker"><%= t('home.articles.kicker') %></span><h2><%= t('home.articles.heading') %></h2><p><%= t('home.articles.sub') %></p></div><a class="text-link" href="/articles"><%= t('home.articles.viewAll') %> <span>←</span></a></div>
  <% if (articles.length) { %><div class="article-grid reveal-stagger"><% articles.forEach((a, i) => { %><% const aTitle = localizedField(a,'title','title_en'); %><a href="/articles/<%= a.slug %>" class="article-card reveal-item"><div class="article-image"><% if (a.cover_image) { %><img src="<%= a.cover_image %>" alt="<%= aTitle %>" loading="lazy"><% } else { %><div class="article-art art-<%= i%3 %>"><span>NG / <%= String(i+1).padStart(2,'0') %></span><b>ENGINEERING<br>JOURNAL</b></div><% } %></div><div class="article-copy"><div class="article-meta"><span><%= categoryLabel(a.category) %></span><span><%= a.published_at ? new Date(a.published_at).toLocaleDateString(locale==='en'?'en-US':'fa-IR') : t('home.articles.categoryFallback') %></span></div><h3><%= aTitle %></h3><p><%= localizedField(a,'excerpt','excerpt_en') %></p><span class="article-read"><%= t('home.articles.readMore') %> <span>←</span></span></div></a><% }) %></div><% } else { %><div class="empty-state empty-light"><span>▧</span><h3><%= t('home.articles.emptyTitle') %></h3><p><%= t('home.articles.emptyDesc') %></p></div><% } %>
</div></section>
<section class="cta-section"><div class="container cta-inner"><div><span class="section-kicker kicker-light">Novingity / YOUR WORKSPACE</span><h2><%= t('home.cta.headingPre') %><br><%= t('home.cta.headingPost') %></h2><p><%= t('home.cta.sub') %></p></div><a class="button button-light button-large" href="/login"><%= t('home.cta.action') %> <span>←</span></a></div></section>
<%- include('partials/footer') %>
