<%- include('partials/header', {title}) %>
<script>window.NG_LOCALE = '<%= locale %>';</script>
<section class="page-hero tools-hero"><div class="container"><div class="breadcrumb"><a href="/"><%= t('tools.breadcrumbHome') %></a><span>/</span><span><%= t('tools.breadcrumbSelf') %></span></div><span class="section-kicker">ENGINEERING CALCULATORS</span><h1><%= t('tools.titlePre') %><br><em><%= t('tools.titleEm') %></em></h1><p><%= t('tools.lead') %></p><div class="tools-disclaimer"><span>i</span><p><%= t('tools.disclaimer') %></p></div></div></section>
<%- include('partials/flow-divider') %>
<section class="section tools-section"><div class="container"><div class="tools-nav"><a href="#vent" class="tools-nav-item"><span>01</span><%= t('tools.nav1') %></a><a href="#pipe" class="tools-nav-item"><span>02</span><%= t('tools.nav2') %></a><a href="#highPressurePipe" class="tools-nav-item"><span>03</span><%= t('tools.nav3') %></a><a href="#chimney" class="tools-nav-item"><span>04</span><%= t('tools.nav4') %></a><a href="#meter" class="tools-nav-item"><span>05</span><%= t('tools.nav5') %></a><a href="#converter" class="tools-nav-item"><span>06</span><%= t('tools.nav7') %></a><a href="#download" class="tools-nav-item"><span>07</span><%= t('tools.nav8') %></a></div>
<div class="calculators-grid reveal-stagger">
<section id="vent" class="calculator-card reveal-item"><div class="calc-head"><span class="calc-number">01</span><span class="calc-icon">↗</span><div><span class="section-kicker">AIR SUPPLY</span><h2><%= t('tools.vent.title') %></h2></div></div><p class="calc-description"><%= t('tools.vent.desc') %></p><div class="form-stack"><div><label for="area"><%= t('tools.vent.area') %></label><input class="form-control" type="number" id="area" min="0.1" step="0.1" placeholder="<%= t('tools.vent.areaPlaceholder') %>"></div><div><label for="height"><%= t('tools.vent.height') %></label><input class="form-control" type="number" id="height" min="0.1" step="0.1" placeholder="<%= t('tools.vent.heightPlaceholder') %>"></div><div><label for="deviceConsumption"><%= t('tools.vent.consumption') %></label><input class="form-control" type="number" id="deviceConsumption" min="0.1" step="0.1" placeholder="<%= t('tools.vent.consumptionPlaceholder') %>"></div><button class="button button-primary button-block" type="button" data-calc="vent"><%= t('tools.vent.submit') %> <span>←</span></button></div><div id="ventResult" class="calc-result" aria-live="polite"></div></section>
<section id="pipe" class="calculator-card reveal-item"><div class="calc-head"><span class="calc-number">02</span><span class="calc-icon">⌁</span><div><span class="section-kicker">LOW PRESSURE</span><h2><%= t('tools.pipe.title') %></h2></div></div><p class="calc-description"><%= t('tools.pipe.desc') %></p><div class="form-stack"><div><label for="pipeLength"><%= t('tools.pipe.length') %></label><input class="form-control" type="number" id="pipeLength" min="0.1" step="0.1" placeholder="<%= t('tools.pipe.lengthPlaceholder') %>"></div><div><label for="consumption"><%= t('tools.pipe.consumption') %></label><input class="form-control" type="number" id="consumption" min="0.1" step="0.1" placeholder="<%= t('tools.pipe.consumptionPlaceholder') %>"></div><button class="button button-primary button-block" type="button" data-calc="pipe"><%= t('tools.pipe.submit') %> <span>←</span></button></div><div id="pipeResult" class="calc-result" aria-live="polite"></div></section>
<section id="highPressurePipe" class="calculator-card reveal-item"><div class="calc-head"><span class="calc-number">03</span><span class="calc-icon">⌇</span><div><span class="section-kicker">2 PSI</span><h2><%= t('tools.hp.title') %></h2></div></div><p class="calc-description"><%= t('tools.hp.desc') %></p><div class="form-stack"><div><label for="hpPipeLength"><%= t('tools.hp.length') %></label><input class="form-control" type="number" id="hpPipeLength" min="0.1" step="0.1" placeholder="<%= t('tools.hp.lengthPlaceholder') %>"></div><div><label for="hpConsumption"><%= t('tools.hp.consumption') %></label><input class="form-control" type="number" id="hpConsumption" min="0.1" step="0.1" placeholder="<%= t('tools.hp.consumptionPlaceholder') %>"></div><button class="button button-primary button-block" type="button" data-calc="high"><%= t('tools.hp.submit') %> <span>←</span></button></div><div id="hpPipeResult" class="calc-result" aria-live="polite"></div></section>
<section id="chimney" class="calculator-card reveal-item"><div class="calc-head"><span class="calc-number">04</span><span class="calc-icon">⇧</span><div><span class="section-kicker">FLUE / CHIMNEY</span><h2><%= t('tools.chimney.title') %></h2></div></div><p class="calc-description"><%= t('tools.chimney.desc') %></p><div class="form-stack"><div><label for="chimneyHeight"><%= t('tools.chimney.height') %></label><input class="form-control" type="number" id="chimneyHeight" min="0.1" step="0.1" placeholder="<%= t('tools.chimney.heightPlaceholder') %>"></div><div><label for="chimneyLength"><%= t('tools.chimney.length') %></label><input class="form-control" type="number" id="chimneyLength" min="0" step="0.1" placeholder="<%= t('tools.chimney.lengthPlaceholder') %>"></div><div><label for="chimneyConsumption"><%= t('tools.chimney.consumption') %></label><input class="form-control" type="number" id="chimneyConsumption" min="0.1" step="0.1" placeholder="<%= t('tools.chimney.consumptionPlaceholder') %>"></div><button class="button button-primary button-block" type="button" data-calc="chimney"><%= t('tools.chimney.submit') %> <span>←</span></button></div><div id="chimneyResult" class="calc-result" aria-live="polite"></div></section>
<section id="meter" class="calculator-card reveal-item"><div class="calc-head"><span class="calc-number">05</span><span class="calc-icon">◉</span><div><span class="section-kicker">GAS METER</span><h2><%= t('tools.meter.title') %></h2></div></div><p class="calc-description"><%= t('tools.meter.desc') %></p><div class="form-stack"><div><label for="meterConsumption"><%= t('tools.meter.consumption') %></label><input class="form-control" type="number" id="meterConsumption" min="0.1" step="0.1" placeholder="<%= t('tools.meter.consumptionPlaceholder') %>"></div><button class="button button-primary button-block" type="button" data-calc="meter"><%= t('tools.meter.submit') %> <span>←</span></button></div><div id="meterResult" class="calc-result" aria-live="polite"></div></section>
<section id="converter" class="calculator-card reveal-item"><div class="calc-head"><span class="calc-number">06</span><span class="calc-icon">⇄</span><div><span class="section-kicker">FUEL CONVERTER</span><h2><%= t('tools.converter.title') %></h2></div></div><p class="calc-description"><%= t('tools.converter.desc') %></p><div class="form-stack"><div><label for="fuelType"><%= t('tools.converter.fuelType') %></label><select class="form-control" id="fuelType"><option value="0.85"><%= t('tools.converter.gasoline') %></option><option value="0.865"><%= t('tools.converter.kerosene') %></option><option value="0.897"><%= t('tools.converter.diesel') %></option><option value="0.911"><%= t('tools.converter.fuelOil') %></option><option value="1.0"><%= t('tools.converter.lpg') %></option></select></div><div><label for="gasInput"><%= t('tools.converter.gasLabel') %></label><input class="form-control" type="number" id="gasInput" min="0" step="0.01" placeholder="<%= t('tools.converter.gasPlaceholder') %>"></div><div><label><%= t('tools.converter.liquidLabel') %> (<span id="liquidUnit"><%= t('tools.converter.literUnit') %></span>)</label><input class="form-control" type="number" id="liquidInput" min="0" step="0.01" placeholder="<%= t('tools.converter.liquidPlaceholder') %>"></div></div><div id="converterInfo" class="converter-info"><%= t('tools.converter.factorLabel') %>: <b id="factorDisplay">0.85</b> (<%= t('tools.converter.equivalentLabel') %>: <b id="factorDisplay2">0.85</b> m³)</div></section>
<section id="download" class="calculator-card download-card reveal-item"><div class="calc-head"><span class="calc-number">07</span><span class="calc-icon">↓</span><div><span class="section-kicker">NATIONAL BUILDING REGULATIONS</span><h2><%= t('tools.download.title') %></h2></div></div><p class="calc-description"><%= t('tools.download.desc') %></p><a class="download-option" href="https://inbr.s3.ir-thr-at1.arvanstorage.ir/mabahse%2Fmabahse17%2Fmabhas17-watermark-1403-02.pdf?versionId=" target="_blank" rel="noopener noreferrer"><span>PDF</span><span><b><%= t('tools.download.edition1403') %></b><small><%= t('tools.download.open') %></small></span><strong>↗</strong></a><a class="download-option" href="https://inbr.s3.ir-thr-at1.arvanstorage.ir/mabahse%2Fmabahse17%2Fmabhas17-1401-07.pdf?versionId=" target="_blank" rel="noopener noreferrer"><span>PDF</span><span><b><%= t('tools.download.edition1401') %></b><small><%= t('tools.download.open') %></small></span><strong>↗</strong></a></section>
</div><p class="tools-bottom-note"><%= t('tools.bottomNote') %></p></div></section>
<script defer src="/public/js/tools.js"></script>
<%- include('partials/footer') %>
