<%- include('partials/header', {title}) %>
<section class="auth-section"><div class="auth-decoration"><span class="section-kicker kicker-light">Nogiti ACCOUNT</span><h2>همه چیز برای<br>ادامهٔ مسیر مهندسی.</h2><p>خریدها، دوره‌ها و فایل‌های اختصاصی‌تان را در یک کتابخانهٔ شخصی دنبال کنید.</p><div class="auth-art"><span>01</span><span>NG / USER</span><span>∞</span></div></div><div class="auth-form-wrap"><div class="auth-form"><a href="/" class="back-home">← بازگشت به سایت</a><span class="section-kicker">حساب کاربری</span><h1><%= step==='code' ? 'کد تأیید را وارد کنید' : 'ورود یا ساخت حساب' %></h1><p><%= step==='code' ? (draftPhone ? `کد ۶ رقمی ارسال‌شده به ${draftPhone} را وارد کنید.` : 'کد ۶ رقمی ارسال‌شده به موبایل‌تان را وارد کنید.') : 'با شماره موبایل خود وارد شوید؛ حساب شما به‌صورت خودکار ساخته می‌شود.' %></p>
<% if (step==='code') { %><% if (devOtp) { %><div class="dev-hint">کد آزمایشی محیط توسعه: <strong><%= devOtp %></strong><small>این پیام فقط در حالت توسعه نمایش داده می‌شود.</small></div><% } %><form action="/auth/verify-code" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="code">کد تأیید</label><input id="code" name="code" class="form-control code-input" placeholder="••••••" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required><button class="button button-primary button-large button-block" type="submit">تأیید و ورود <span>←</span></button></form><a class="auth-resend" href="/login">ارسال کد جدید / تغییر شماره</a><% } else { %><form action="/auth/request-code" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="firstName">نام</label><input class="form-control" id="firstName" name="firstName" placeholder="نام شما" autocomplete="given-name"><label for="lastName">نام خانوادگی</label><input class="form-control" id="lastName" name="lastName" placeholder="نام خانوادگی شما" autocomplete="family-name"><label for="phone">شماره موبایل</label><input class="form-control" id="phone" name="phone" placeholder="09123456789" inputmode="tel" autocomplete="tel" dir="ltr" maxlength="20" required><button class="button button-primary button-large button-block" type="submit">دریافت کد تأیید <span>←</span></button></form><div class="auth-privacy">با ورود، شماره موبایل شما برای ایجاد حساب و پیگیری سفارش‌ها استفاده می‌شود.</div><% } %></div></div></section>
<%- include('partials/footer') %>
