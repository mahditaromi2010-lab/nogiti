<%- include('partials/header', {title}) %>
<section class="auth-section"><div class="auth-decoration"><span class="section-kicker kicker-light"><%= t('kicker.account') %></span><h2><%= t('login.sideTitlePre') %><br><%= t('login.sideTitlePost') %></h2><p><%= t('login.sideDesc') %></p><div class="auth-art"><span>01</span><span>NG / USER</span><span>∞</span></div></div><div class="auth-form-wrap"><div class="auth-form"><a href="/" class="back-home">← <%= t('login.backHome') %></a><span class="section-kicker"><%= t('login.kicker') %></span><h1><%= step==='code' ? t('login.codeTitle') : t('login.phoneTitle') %></h1><p><%= step==='code' ? (draftPhone ? `${t('login.codeSentTo')} ${draftPhone}` : t('login.codeSentGeneric')) : t('login.phoneLead') %></p>
<% if (step==='code') { %><% if (devOtp) { %><div class="dev-hint"><%= t('login.devOtpLabel') %> <strong><%= devOtp %></strong><small><%= t('login.devOtpNote') %></small></div><% } %><form action="/auth/verify-code" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="code"><%= t('login.codeLabel') %></label><input id="code" name="code" class="form-control code-input" placeholder="••••••" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required><button class="button button-primary button-large button-block" type="submit"><%= t('login.verifySubmit') %> <span>←</span></button></form><a class="auth-resend" href="/login"><%= t('login.resend') %></a><% } else { %><form action="/auth/request-code" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="firstName"><%= t('login.firstName') %></label><input class="form-control" id="firstName" name="firstName" placeholder="<%= t('login.firstNamePlaceholder') %>" autocomplete="given-name"><label for="lastName"><%= t('login.lastName') %></label><input class="form-control" id="lastName" name="lastName" placeholder="<%= t('login.lastNamePlaceholder') %>" autocomplete="family-name"><label for="phone"><%= t('login.phoneLabel') %></label><input class="form-control" id="phone" name="phone" placeholder="09123456789" inputmode="tel" autocomplete="tel" dir="ltr" maxlength="20" required><button class="button button-primary button-large button-block" type="submit"><%= t('login.requestCodeSubmit') %> <span>←</span></button></form><div class="auth-privacy"><%= t('login.privacyNote') %></div><% } %></div></div></section>
<%- include('partials/footer') %>
