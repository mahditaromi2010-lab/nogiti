<%- include('../partials/header', {title}) %>
<section class="auth-section"><div class="auth-decoration"><span class="section-kicker kicker-light">Novingity CONTROL CENTER</span><h2><%= t('adminLogin.sideTitlePre') %><br><%= t('adminLogin.sideTitlePost') %></h2><p><%= t('adminLogin.sideDesc') %></p><div class="auth-art"><span>ADMIN</span><span>CONTROL / 01</span><span>✳</span></div></div><div class="auth-form-wrap"><div class="auth-form"><a href="/" class="back-home">← <%= t('login.backHome') %></a><span class="section-kicker"><%= t('adminLogin.kicker') %></span><h1><%= t('adminLogin.title') %></h1><p><%= t('adminLogin.lead') %></p><form action="/admin/login" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="username"><%= t('adminLogin.username') %></label><input class="form-control" id="username" name="username" placeholder="admin_username" dir="ltr" autocomplete="username" autocapitalize="none" spellcheck="false" minlength="3" maxlength="64" pattern="[A-Za-z0-9_.-]{3,64}" required><label for="password"><%= t('adminLogin.password') %></label><div class="password-field"><input class="form-control" id="password" name="password" type="password" autocomplete="current-password" maxlength="200" required dir="ltr"><button type="button" class="password-toggle" data-password-toggle="password" aria-pressed="false" aria-label="<%= t('adminLogin.showPassword') %>"><%= t('adminLogin.showPasswordLabel') %></button></div><small class="caps-warning" data-caps-warning hidden><%= t('adminLogin.capsLockOn') %></small><button class="button button-primary button-large button-block" type="submit" data-busy-label="<%= t('adminLogin.checking') %>"><%= t('adminLogin.submit') %> <span aria-hidden="true">←</span></button></form><div class="auth-privacy"><%= t('adminLogin.privacyNote') %></div></div></div></section>
<%- include('../partials/footer') %>
