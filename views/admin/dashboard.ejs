<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
<div class="admin-topbar"><div><span class="section-kicker">OVERVIEW / Nogiti</span><h1>نمای کلی سایت</h1><p>اعداد مستقیماً از پایگاه داده خوانده می‌شوند؛ فروش فقط شامل سفارش‌هایی است که پرداختشان در سرور تأیید شده است.</p></div><a href="/" class="button button-outline button-small">مشاهده سایت ↗</a></div>
<% const fa = n => Number(n || 0).toLocaleString('fa-IR'); %>
<div class="admin-stats">
  <a class="stat-card" href="/admin/users?state=active"><span>کاربران فعال</span><b><%= fa(counts.active_users) %></b><small><%= fa(counts.new_users_30d) %> عضو جدید در ۳۰ روز اخیر</small><span class="stat-icon" aria-hidden="true">♙</span></a>
  <a class="stat-card" href="/admin/products?status=published"><span>محصولات منتشرشده</span><b><%= fa(counts.published_products) %></b><small><%= fa(drafts.products) %> پیش‌نویس</small><span class="stat-icon" aria-hidden="true">▤</span></a>
  <a class="stat-card" href="/admin/articles?status=published"><span>مقالات منتشرشده</span><b><%= fa(counts.published_articles) %></b><small><%= fa(drafts.articles) %> پیش‌نویس</small><span class="stat-icon" aria-hidden="true">▧</span></a>
  <a class="stat-card" href="/admin/orders?status=paid"><span>پرداخت‌های موفق</span><b><%= fa(counts.paid_orders) %></b><small><%= fa(counts.pending_orders) %> در انتظار (۲۴ ساعت) · <%= fa(counts.failed_orders_7d) %> ناموفق (۷ روز)</small><span class="stat-icon" aria-hidden="true">✓</span></a>
</div>
<div class="admin-revenue-row"><div class="revenue-card"><div><span class="section-kicker">TOTAL VERIFIED SALES</span><h2>مجموع فروش تأییدشده</h2><p>۷ روز اخیر: <b><%= money(sales.last_7d) %></b> · ۳۰ روز اخیر: <b><%= money(sales.last_30d) %></b></p></div><strong><%= money(sales.total) %></strong></div>
<div class="quick-actions"><h3>دسترسی سریع</h3><a href="/admin/products/new">＋ افزودن محصول جدید</a><a href="/admin/articles/new">＋ نوشتن مقاله</a><a href="/admin/orders?status=pending">سفارش‌های در انتظار ←</a><% if (can('support')) { %><a href="/admin/tickets?status=open">تیکت‌های باز (<%= fa(openTickets) %>) ←</a><% } %><% if (can('admins')) { %><a href="/admin/admins">مدیریت مدیران ←</a><% } %></div></div>
<section class="admin-panel"><div class="admin-panel-head"><div><h2>آخرین سفارش‌ها</h2><p>وضعیت پرداخت و خریدار</p></div><a class="text-link" href="/admin/orders">همه سفارش‌ها ←</a></div><div class="table-responsive"><table class="data-table"><caption class="sr-only">آخرین سفارش‌ها</caption><thead><tr><th scope="col">سفارش</th><th scope="col">خریدار</th><th scope="col">تاریخ</th><th scope="col">مبلغ</th><th scope="col">وضعیت</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= (o.first_name+' '+o.last_name).trim() || o.phone %><small class="table-sub" dir="ltr"><%= o.phone %></small></td><td><%= new Date(o.created_at).toLocaleDateString('fa-IR') %></td><td><%= money(o.total_toman) %></td><td><span class="status-pill status-<%= o.status %>"><%= orderStatusLabels[o.status] || o.status %></span></td></tr><% }) %><% if(!orders.length){ %><tr><td colspan="5" class="table-empty">هنوز سفارشی ثبت نشده است.</td></tr><% } %></tbody></table></div></section>
<% if (audit.length) { %><section class="admin-panel"><div class="admin-panel-head"><div><h2>آخرین رویدادهای امنیتی</h2><p>ورودها و تغییرات مهم پنل</p></div><a class="text-link" href="/admin/audit">گزارش کامل ←</a></div>
<ul class="audit-mini"><% audit.forEach(e => { %><li><span class="status-dot <%= e.status_code < 400 ? 'ok' : 'bad' %>" aria-hidden="true"></span><code dir="ltr"><%= e.action %></code><span><%= e.username || 'ناشناس' %></span><time datetime="<%= new Date(e.created_at).toISOString() %>"><%= new Date(e.created_at).toLocaleString('fa-IR', { dateStyle: 'short', timeStyle: 'short' }) %></time></li><% }) %></ul></section><% } %>
</div></div><%- include('../partials/footer') %>
