<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
<div class="admin-topbar"><div><span class="section-kicker">OVERVIEW / Novingity</span><h1><%= t('adminDash.title') %></h1><p><%= t('adminDash.lead') %></p></div><a href="/" class="button button-outline button-small"><%= t('adminDash.viewSite') %> ↗</a></div>
<% const numFmt = n => Number(n || 0).toLocaleString(locale==='en'?'en-US':'fa-IR'); const dateFmt = d => new Date(d).toLocaleDateString(locale==='en'?'en-US':'fa-IR'); %>
<% if (locals.mapKey && coverageMapEnabled && can('content')) { const mk = mapKey; const mapLink = '<a class="text-link" href="/coverage-map">' + t('adminDash.mapPreview') + ' ←</a>'; %>
<% if (mk.usable && mk.expiringSoon) { %><div class="admin-alert admin-alert-warn" role="status" data-map-key="expiring"><%= t('adminDash.mapKeyExpiring').replace('{days}', numFmt(Math.max(mk.daysLeft, 0))).replace('{date}', dateFmt(mk.expiresAt)) %> <%- mapLink %></div><% } else if (mk.configured && !mk.usable) { %><div class="admin-alert admin-alert-warn" role="status" data-map-key="expired"><%= t('adminDash.mapKeyExpired') %> <%- mapLink %></div><% } else if (!mk.configured && coverageMapEnabled) { %><div class="admin-alert" role="status" data-map-key="missing"><%= t('adminDash.mapKeyMissing') %></div><% } %>
<% } %>
<div class="admin-stats">
  <a class="stat-card" href="/admin/users?state=active"><span><%= t('adminDash.activeUsers') %></span><b><%= numFmt(counts.active_users) %></b><small><%= numFmt(counts.new_users_30d) %> <%= t('adminDash.newMembers30d') %></small><span class="stat-icon" aria-hidden="true">♙</span></a>
  <a class="stat-card" href="/admin/products?status=published"><span><%= t('adminDash.publishedProducts') %></span><b><%= numFmt(counts.published_products) %></b><small><%= numFmt(drafts.products) %> <%= t('adminDash.drafts') %></small><span class="stat-icon" aria-hidden="true">▤</span></a>
  <a class="stat-card" href="/admin/articles?status=published"><span><%= t('adminDash.publishedArticles') %></span><b><%= numFmt(counts.published_articles) %></b><small><%= numFmt(drafts.articles) %> <%= t('adminDash.drafts') %></small><span class="stat-icon" aria-hidden="true">▧</span></a>
  <a class="stat-card" href="/admin/orders?status=paid"><span><%= t('adminDash.successfulPayments') %></span><b><%= numFmt(counts.paid_orders) %></b><small><%= numFmt(counts.pending_orders) %> <%= t('adminDash.pending24h') %> · <%= numFmt(counts.failed_orders_7d) %> <%= t('adminDash.failed7d') %></small><span class="stat-icon" aria-hidden="true">✓</span></a>
</div>
<div class="admin-revenue-row"><div class="revenue-card"><div><span class="section-kicker">TOTAL VERIFIED SALES</span><h2><%= t('adminDash.totalVerifiedSales') %></h2><p><%= t('adminDash.last7d') %>: <b><%= money(sales.last_7d) %></b> · <%= t('adminDash.last30d') %>: <b><%= money(sales.last_30d) %></b></p></div><strong><%= money(sales.total) %></strong></div>
<div class="quick-actions"><h3><%= t('adminDash.quickActions') %></h3><a href="/admin/products/new">＋ <%= t('adminDash.addProduct') %></a><a href="/admin/articles/new">＋ <%= t('adminDash.writeArticle') %></a><a href="/admin/orders?status=pending"><%= t('adminDash.pendingOrders') %> ←</a><% if (can('support')) { %><a href="/admin/tickets?status=open"><%= t('adminDash.openTickets') %> (<%= numFmt(openTickets) %>) ←</a><% } %><% if (can('admins')) { %><a href="/admin/admins"><%= t('adminDash.manageAdmins') %> ←</a><% } %></div></div>
<section class="admin-panel"><div class="admin-panel-head"><div><h2><%= t('adminDash.recentOrders') %></h2><p><%= t('adminDash.recentOrdersDesc') %></p></div><a class="text-link" href="/admin/orders"><%= t('adminDash.allOrders') %> ←</a></div><div class="table-responsive"><table class="data-table"><caption class="sr-only"><%= t('adminDash.recentOrders') %></caption><thead><tr><th scope="col"><%= t('adminDash.order') %></th><th scope="col"><%= t('adminDash.buyer') %></th><th scope="col"><%= t('common.date') %></th><th scope="col"><%= t('account.amount') %></th><th scope="col"><%= t('common.status') %></th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= (o.first_name+' '+o.last_name).trim() || o.phone %><small class="table-sub" dir="ltr"><%= o.phone %></small></td><td><%= dateFmt(o.created_at) %></td><td><%= money(o.total_toman) %></td><td><span class="status-pill status-<%= o.status %>"><%= orderStatusLabels[o.status] || o.status %></span></td></tr><% }) %><% if(!orders.length){ %><tr><td colspan="5" class="table-empty"><%= t('account.noOrdersYet') %></td></tr><% } %></tbody></table></div></section>
<% if (audit.length) { %><section class="admin-panel"><div class="admin-panel-head"><div><h2><%= t('adminDash.recentSecurityEvents') %></h2><p><%= t('adminDash.recentSecurityEventsDesc') %></p></div><a class="text-link" href="/admin/audit"><%= t('adminDash.fullReport') %> ←</a></div>
<ul class="audit-mini"><% audit.forEach(e => { %><li><span class="status-dot <%= e.status_code < 400 ? 'ok' : 'bad' %>" aria-hidden="true"></span><code dir="ltr"><%= e.action %></code><span><%= e.username || t('adminDash.unknownUser') %></span><time datetime="<%= new Date(e.created_at).toISOString() %>"><%= new Date(e.created_at).toLocaleString(locale==='en'?'en-US':'fa-IR', { dateStyle: 'short', timeStyle: 'short' }) %></time></li><% }) %></ul></section><% } %>
</div></div><%- include('../partials/footer') %>
