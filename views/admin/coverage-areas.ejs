<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
<div class="admin-topbar"><div><span class="section-kicker">HORMOZGAN COVERAGE MAP</span><h1>مناطق نقشهٔ هرمزگان</h1><p>این رکوردها منبع دادهٔ صفحهٔ عمومی <a href="/coverage-map" target="_blank" rel="noopener">نقشهٔ هرمزگان</a> و endpoint داده (<code dir="ltr">/api/coverage-areas</code>) هستند. تا زمانی که «داده نمایشی/آزمایشی» تیک‌خورده باشد، در نقشه با برچسب preliminary نمایش داده می‌شوند.</p></div><a href="/admin/coverage-areas/new" class="button button-primary button-small">＋ منطقهٔ جدید</a></div>
<section class="admin-panel">
  <div class="table-responsive"><table class="data-table"><caption class="sr-only">مناطق نقشهٔ هرمزگان</caption><thead><tr><th scope="col">نام پروژه</th><th scope="col">شهر</th><th scope="col">تعداد پروژه</th><th scope="col">وضعیت پروژه</th><th scope="col">وضعیت گاز</th><th scope="col">داده نمایشی</th><th scope="col">به‌روزرسانی</th><th scope="col"></th></tr></thead><tbody>
  <% areas.forEach(a => { %><tr>
    <td><b><%= a.project_name %></b><% if (a.district) { %><small class="table-sub"><%= a.district %></small><% } %></td>
    <td><%= a.city %></td>
    <td><%= a.project_count %></td>
    <td><span class="status-pill status-ticket-<%= a.project_status==='completed'?'closed':(a.project_status==='planned'?'open':'pending') %>"><%= projectStatusLabels[a.project_status] || a.project_status %></span></td>
    <td><%= gasStatusLabels[a.gas_service_status] || a.gas_service_status %></td>
    <td><span class="status-pill <%= a.is_demo ? 'status-draft' : 'status-published' %>"><%= a.is_demo ? 'بله' : 'خیر' %></span></td>
    <td><%= new Date(a.last_updated).toLocaleDateString('fa-IR') %></td>
    <td><div class="row-actions"><a href="/admin/coverage-areas/<%= a.id %>/edit">ویرایش</a><form action="/admin/coverage-areas/<%= a.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="button-link danger-text" data-confirm="این منطقه از نقشه حذف شود؟ درخواست‌های مشاورهٔ مرتبط حذف نمی‌شوند اما ارجاعشان به این منطقه برداشته می‌شود." data-confirm-label="حذف کن">حذف</button></form></div></td>
  </tr><% }) %>
  <% if (!areas.length) { %><tr><td colspan="8" class="table-empty">هنوز منطقه‌ای ثبت نشده است.</td></tr><% } %>
  </tbody></table></div>
</section></div></div><%- include('../partials/footer') %>
