<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
<div class="admin-topbar"><div><span class="section-kicker">CUSTOMER SUPPORT</span><h1><%= t('admin.tickets.title') %></h1><p><%= t('admin.tickets.subtitle') %></p></div></div>
<section class="admin-panel">
  <form class="filter-bar" method="get" action="/admin/tickets" role="search">
    <div class="filter-field filter-grow"><label for="f-q"><%= t('common.search') %></label><input class="form-control" id="f-q" name="q" type="search" value="<%= filters.q %>" placeholder="موضوع تیکت" maxlength="100"></div>
    <div class="filter-field"><label for="f-status"><%= t('common.status') %></label><select class="form-control" id="f-status" name="status"><option value=""><%= t('common.all') %></option><% ['open','pending','answered','closed'].forEach(s => { %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= t('tickets.status.'+s) %></option><% }) %></select></div>
    <div class="filter-field"><label for="f-priority"><%= t('common.priority') %></label><select class="form-control" id="f-priority" name="priority"><option value=""><%= t('common.all') %></option><% ['low','normal','high','urgent'].forEach(p => { %><option value="<%= p %>" <%= filters.priority===p?'selected':'' %>><%= t('tickets.priority.'+p) %></option><% }) %></select></div>
    <div class="filter-actions"><button class="button button-dark button-small" type="submit"><%= t('common.filter') %></button><% if (filters.q || filters.status || filters.priority) { %><a class="button button-quiet button-small" href="/admin/tickets"><%= t('common.clearFilters') %></a><% } %></div>
  </form>
  <div class="table-responsive"><table class="data-table"><caption class="sr-only"><%= t('admin.tickets.title') %></caption><thead><tr><th scope="col">#</th><th scope="col"><%= t('tickets.subject') %></th><th scope="col">کاربر</th><th scope="col"><%= t('common.category') %></th><th scope="col"><%= t('common.priority') %></th><th scope="col"><%= t('common.status') %></th><th scope="col"><%= t('common.date') %></th></tr></thead><tbody>
  <% tickets.forEach(tk => { %><tr><td><a href="/admin/tickets/<%= tk.id %>">#<%= tk.id %></a></td><td><a href="/admin/tickets/<%= tk.id %>"><%= tk.subject %></a></td><td><%= (tk.first_name+' '+tk.last_name).trim() || tk.phone %><small class="table-sub" dir="ltr"><%= tk.phone %></small></td><td><%= t('tickets.category.'+tk.category) %></td><td><%= t('tickets.priority.'+tk.priority) %></td><td><span class="status-pill status-ticket-<%= tk.status %>"><%= t('tickets.status.'+tk.status) %></span></td><td><%= new Date(tk.created_at).toLocaleDateString('fa-IR') %></td></tr><% }) %>
  <% if (!tickets.length) { %><tr><td colspan="7" class="table-empty"><%= t('admin.tickets.noneYet') %></td></tr><% } %>
  </tbody></table></div>
  <%- include('../partials/pagination', { pg, base: '/admin/tickets', params: filters }) %>
</section></div></div><%- include('../partials/footer') %>
