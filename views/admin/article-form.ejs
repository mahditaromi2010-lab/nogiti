<%- include('../partials/header', {title}) %>
<div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
  <div class="admin-topbar"><div><span class="section-kicker">ARTICLE EDITOR</span><h1><%= article ? 'ویرایش مقاله' : 'مقاله جدید' %></h1><p>عنوان، محتوای مقاله و تصاویر را در همین بخش مدیریت کنید.</p></div><a href="/admin/articles" class="button button-outline button-small">بازگشت به مقالات</a></div>
  <form class="admin-panel admin-form" action="<%= article ? `/admin/articles/${article.id}/edit` : '/admin/articles' %>" method="post" enctype="multipart/form-data" data-unsaved-guard>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="form-field form-span-2"><label for="title">عنوان مقاله *</label><input class="form-control" id="title" name="title" value="<%= article?.title || '' %>" required></div>
      <div class="form-field"><label for="slug">نشانی کوتاه</label><input class="form-control" id="slug" name="slug" value="<%= article?.slug || '' %>" placeholder="در صورت خالی بودن خودکار ساخته می‌شود"></div>
      <div class="form-field"><label for="category">دسته‌بندی</label><input class="form-control" id="category" name="category" value="<%= article?.category || 'مقالات تخصصی' %>"></div>
      <div class="form-field form-span-2"><label for="excerpt">خلاصه / توضیح کوتاه</label><textarea class="form-control" id="excerpt" name="excerpt" rows="3" maxlength="600"><%= article?.excerpt || '' %></textarea></div>
      <div class="form-field form-span-2"><label for="content">متن مقاله *</label><textarea class="form-control article-textarea" id="content" name="content" rows="18" required><%= article?.content || '' %></textarea><small>هر خط یک پاراگراف است. برای درج تصویر، کد آن را در یک خط جدا قرار دهید (مثال: [[image:12]]). HTML خام پذیرفته نمی‌شود.</small><details class="syntax-help"><summary>راهنمای قالب‌بندی متن</summary><ul><li><code>## عنوان</code> و <code>### زیرعنوان</code></li><li><code>- مورد</code> برای فهرست نقطه‌ای و <code>1. مورد</code> برای فهرست شماره‌دار</li><li><code>&gt; متن</code> برای نقل‌قول یا نکتهٔ مهم</li><li><code>**متن پررنگ**</code> و <code>[عنوان پیوند](https://...)</code></li></ul></details></div>
      <div class="form-field"><label for="cover">تصویر شاخص مقاله</label><input class="form-control file-control" id="cover" type="file" name="cover" accept="image/jpeg,image/png,image/webp,image/gif"><small>حداکثر ۸ مگابایت.</small></div>
      <div class="form-field"><label for="cover_url">یا نشانی تصویر شاخص</label><input class="form-control" id="cover_url" name="cover_url" dir="ltr" value="<%= article?.cover_image || '' %>" placeholder="https://..."></div>
      <div class="form-field form-span-2"><label for="inline_images">تصاویر داخل مقاله (حداکثر ۱۰ تصویر در هر بار)</label><input class="form-control file-control" id="inline_images" type="file" name="inline_images" accept="image/jpeg,image/png,image/webp,image/gif" multiple><small>هر تصویر حداکثر ۸ مگابایت است. پس از ذخیره، کد درج تصاویر پایین صفحه نمایش داده می‌شود.</small></div>
      <div class="form-field form-span-2"><label for="inline_alt">متن جایگزین/شرح تصاویر جدید</label><input class="form-control" id="inline_alt" name="inline_alt" maxlength="180" placeholder="شرح کوتاه تصویر برای دسترس‌پذیری و سئو"></div>
      <div class="form-field"><label for="status">وضعیت</label><select id="status" name="status" class="form-control"><option value="draft" <%= article?.status==='draft'?'selected':'' %>>پیش‌نویس</option><option value="published" <%= article?.status==='published'?'selected':'' %>>منتشرشده</option><option value="archived" <%= article?.status==='archived'?'selected':'' %>>آرشیو</option></select></div>
      <div class="form-field form-span-2"><label><b>English content (optional)</b></label><small>Leave empty to fall back to the Persian text above on the English site.</small></div>
      <div class="form-field form-span-2"><label for="title_en">Title (EN)</label><input class="form-control" dir="ltr" id="title_en" name="title_en" maxlength="220" value="<%= article?.title_en || '' %>"></div>
      <div class="form-field form-span-2"><label for="excerpt_en">Excerpt (EN)</label><textarea class="form-control" dir="ltr" id="excerpt_en" name="excerpt_en" rows="3" maxlength="600"><%= article?.excerpt_en || '' %></textarea></div>
      <div class="form-field form-span-2"><label for="content_en">Body (EN)</label><textarea class="form-control article-textarea" dir="ltr" id="content_en" name="content_en" rows="12"><%= article?.content_en || '' %></textarea><small>Same line-per-paragraph / <code>[[image:ID]]</code> syntax as the Persian body.</small></div>
    </div>
    <div class="form-actions"><button class="button button-primary" type="submit" data-busy-label="در حال ذخیره…">ذخیره مقاله</button><a href="/admin/articles" class="button button-outline">انصراف</a></div>
  </form>
  <% if (article && articleImages && articleImages.length) { %>
    <section class="admin-panel article-image-manager"><div class="admin-panel-head"><div><span class="section-kicker">INLINE ARTICLE IMAGES</span><h2>تصاویر بارگذاری‌شده</h2><p>کد کنار هر تصویر را در خط دلخواه متن مقاله قرار دهید تا همان‌جا نمایش داده شود.</p></div></div>
      <div class="article-image-list"><% articleImages.forEach(img => { %><div class="article-image-item"><img src="<%= img.image_path %>" alt="<%= img.alt_text %>"><div class="article-image-info"><b><%= img.alt_text || 'تصویر مقاله' %></b><code>[[image:<%= img.id %>]]</code><small>برای درج، کد بالا را در یک خط جدا از متن قرار دهید.</small></div><form action="/admin/article-images/<%= img.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="button-link danger-text" data-confirm="این تصویر از مقاله و فضای ذخیره‌سازی حذف شود؟ کد آن در متن دیگر نمایش داده نمی‌شود." data-confirm-label="حذف کن">حذف تصویر</button></form></div><% }) %></div>
    </section>
  <% } %>
</div></div><%- include('../partials/footer') %>
