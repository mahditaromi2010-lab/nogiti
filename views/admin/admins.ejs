<%- include('../partials/header', {title}) %>
<div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
  <div class="admin-topbar"><div><span class="section-kicker">ACCESS CONTROL / OWNER ONLY</span><h1>مدیران و سطح دسترسی</h1><p>حساب‌های مدیریتی مستقل از حساب کاربران عادی؛ رمز عبور هیچ‌گاه نمایش یا ثبت نمی‌شود.</p></div><a class="button button-outline button-small" href="/admin">بازگشت به پنل</a></div>
  <section class="admin-panel"><div class="admin-panel-head"><div><h2>ایجاد حساب مدیر</h2><p>نام کاربری یکتا و رمز اولیهٔ قوی (حداقل ۱۲ نویسه و بدون نام کاربری) تعیین کنید. کمترین نقشی را بدهید که کار فرد با آن انجام می‌شود.</p></div></div>
    <form action="/admin/admins/create" method="post" class="form-stack admin-create-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="new-username">نام کاربری</label><input class="form-control" id="new-username" name="username" dir="ltr" autocomplete="off" autocapitalize="none" spellcheck="false" minlength="3" maxlength="64" pattern="[a-zA-Z0-9_.\-]{3,64}" required>
      <label for="new-password">رمز عبور اولیه</label><div class="password-field"><input class="form-control" id="new-password" name="password" type="password" dir="ltr" autocomplete="new-password" minlength="12" maxlength="200" required><button type="button" class="password-toggle" data-password-toggle="new-password" aria-pressed="false" aria-label="نمایش رمز">نمایش</button></div>
      <label for="new-role">نقش و مجوزها</label><select class="form-control" id="new-role" name="role" required><option value="content">مدیر محتوا — محصولات و مقالات</option><option value="orders">مدیر سفارش‌ها — مشاهدهٔ سفارش‌ها</option><option value="users">مدیر کاربران — فعال/غیرفعال‌سازی کاربران</option><option value="admin">مدیر — همهٔ بخش‌ها به‌جز مدیریت مدیران</option><option value="owner">مدیر اصلی — همهٔ دسترسی‌ها</option></select>
      <div class="form-actions"><button class="button button-primary" type="submit" data-busy-label="در حال ایجاد…">ایجاد حساب مدیر</button></div>
    </form>
  </section>
  <section class="admin-panel"><div class="admin-panel-head"><div><h2>حساب‌های موجود</h2><p>تغییر نقش، نام کاربری، رمز یا وضعیت، همهٔ نشست‌های قبلی آن مدیر را باطل می‌کند. مدیران اصلی فعال: <b><%= Number(activeOwners).toLocaleString('fa-IR') %></b></p></div></div>
    <div class="table-responsive"><table class="data-table"><caption class="sr-only">حساب‌های مدیریتی</caption><thead><tr><th scope="col">حساب</th><th scope="col">نام کاربری و نقش</th><th scope="col">آخرین ورود</th><th scope="col">بازنشانی رمز</th><th scope="col">وضعیت حساب</th></tr></thead><tbody>
    <% admins.forEach(a => { const self = Number(a.id) === Number(currentAdmin.id); const lastOwner = a.role === 'owner' && a.is_active && activeOwners <= 1; %><tr class="<%= a.is_active ? '' : 'row-muted' %>">
      <td><strong dir="ltr"><%= a.username %></strong><% if (self) { %> <span class="tag">شما</span><% } %><small class="table-sub"><%= roleLabels[a.role] %> · شناسه <%= a.id %></small><small class="table-sub">آخرین تغییر رمز: <%= new Date(a.password_changed_at).toLocaleDateString('fa-IR') %></small></td>
      <td><% if (self) { %><small class="muted-text">برای حساب خود از «<a class="text-link" href="/admin/account">حساب من</a>» استفاده کنید.</small><% } else { %><form action="/admin/admins/<%= a.id %>/update" method="post" class="form-stack compact-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control" name="username" dir="ltr" aria-label="نام کاربری <%= a.username %>" value="<%= a.username %>" minlength="3" maxlength="64" pattern="[a-zA-Z0-9_.\-]{3,64}" required><select class="form-control" name="role" aria-label="نقش <%= a.username %>"><% roles.forEach(role => { %><option value="<%= role %>" <%= a.role===role?'selected':'' %> <%= lastOwner && role!=='owner' ? 'disabled' : '' %>><%= roleLabels[role] %></option><% }) %></select><button class="button button-outline button-small" type="submit" data-confirm="مشخصات «<%= a.username %>» ذخیره و نشست‌های فعلی او باطل شود؟" data-confirm-label="ذخیره کن">ذخیره</button></form><% if (lastOwner) { %><small class="muted-text">آخرین مدیر اصلی فعال است؛ نقش آن قابل کاهش نیست.</small><% } %><% } %></td>
      <td><%= a.last_login_at ? new Date(a.last_login_at).toLocaleString('fa-IR') : 'هنوز وارد نشده' %></td>
      <td><% if (self) { %>—<% } else { %><form action="/admin/admins/<%= a.id %>/password" method="post" class="form-stack compact-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control" name="password" type="password" dir="ltr" autocomplete="new-password" aria-label="رمز جدید برای <%= a.username %>" placeholder="رمز جدید (۱۲+ نویسه)" minlength="12" maxlength="200" required><button class="button button-outline button-small" type="submit" data-confirm="رمز «<%= a.username %>» بازنشانی و نشست‌های قبلی او باطل شود؟" data-confirm-label="بازنشانی کن">بازنشانی رمز</button></form><% } %></td>
      <td><span class="status-pill <%= a.is_active?'status-paid':'status-failed' %>"><%= a.is_active?'فعال':'غیرفعال' %></span><% if (!self && !(lastOwner)) { %><form action="/admin/admins/<%= a.id %>/toggle" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-link <%= a.is_active ? 'danger-text' : '' %>" type="submit" data-confirm="<%= a.is_active ? `حساب «${a.username}» غیرفعال و نشست‌هایش باطل شود؟` : `حساب «${a.username}» فعال شود؟` %>" data-confirm-label="<%= a.is_active ? 'غیرفعال کن' : 'فعال کن' %>"><%= a.is_active?'غیرفعال‌سازی':'فعال‌سازی' %></button></form><% } %></td>
    </tr><% }) %><% if (!admins.length) { %><tr><td colspan="5" class="table-empty">هنوز حساب مدیریتی ایجاد نشده است.</td></tr><% } %>
    </tbody></table></div>
  </section>
</div></div><%- include('../partials/footer') %>
