<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
<div class="admin-topbar"><div><span class="section-kicker">HORMOZGAN COVERAGE MAP</span><h1><%= area ? t('adminCoverage.editTitle') : t('adminCoverage.newTitle') %></h1><p><%= t('adminCoverage.formIntro') %> <code dir="ltr">coverage_areas</code> <%= t('adminCoverage.formIntroSuffix') %></p></div><a href="/admin/coverage-areas" class="button button-outline button-small"><%= t('adminCoverage.backToList') %></a></div>
<form class="admin-panel admin-form" action="<%= area ? `/admin/coverage-areas/${area.id}/edit` : '/admin/coverage-areas' %>" method="post" data-unsaved-guard>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-grid">
    <div class="form-field form-span-2"><label for="project_name"><%= t('adminCoverage.projectNameLabel') %> *</label><input class="form-control" id="project_name" name="project_name" maxlength="200" value="<%= area?.project_name || '' %>" required></div>
    <div class="form-field"><label for="province"><%= t('adminCoverage.provinceLabel') %></label><input class="form-control" id="province" name="province" value="<%= area?.province || t('coverageMap.hormozganProvince') %>"></div>
    <div class="form-field"><label for="city"><%= t('adminCoverage.cityLabel') %> *</label><input class="form-control" id="city" name="city" maxlength="120" value="<%= area?.city || '' %>" required></div>
    <div class="form-field"><label for="district"><%= t('adminCoverage.districtLabel') %></label><input class="form-control" id="district" name="district" maxlength="120" value="<%= area?.district || '' %>"></div>
    <div class="form-field"><label for="approximate_location_label"><%= t('adminCoverage.approxLocationLabel') %></label><input class="form-control" id="approximate_location_label" name="approximate_location_label" maxlength="200" value="<%= area?.approximate_location_label || '' %>" placeholder="<%= t('adminCoverage.approxLocationPlaceholder') %>"></div>
    <div class="form-field"><label for="lat"><%= t('adminCoverage.latLabel') %> *</label><input class="form-control" dir="ltr" id="lat" name="lat" type="number" step="0.0001" value="<%= area?.lat ?? '' %>" required></div>
    <div class="form-field"><label for="lng"><%= t('adminCoverage.lngLabel') %> *</label><input class="form-control" dir="ltr" id="lng" name="lng" type="number" step="0.0001" value="<%= area?.lng ?? '' %>" required></div>
    <div class="form-field"><label for="project_count"><%= t('adminCoverage.projectCountLabel') %></label><input class="form-control" id="project_count" name="project_count" type="number" min="0" value="<%= area?.project_count ?? 0 %>"></div>
    <div class="form-field form-span-2"><label for="service_type"><%= t('adminCoverage.serviceTypeLabel') %></label><input class="form-control" id="service_type" name="service_type" maxlength="200" value="<%= area?.service_type || '' %>" placeholder="<%= t('adminCoverage.serviceTypePlaceholder') %>"></div>
    <div class="form-field"><label for="project_status"><%= t('adminCoverage.projectStatusLabel') %></label><select class="form-control" id="project_status" name="project_status"><option value="under_review" <%= (!area||area.project_status==='under_review')?'selected':'' %>><%= t('coverageAdmin.projectStatus.under_review') %></option><option value="planned" <%= area?.project_status==='planned'?'selected':'' %>><%= t('coverageAdmin.projectStatus.planned') %></option><option value="in_progress" <%= area?.project_status==='in_progress'?'selected':'' %>><%= t('coverageAdmin.projectStatus.in_progress') %></option><option value="completed" <%= area?.project_status==='completed'?'selected':'' %>><%= t('coverageAdmin.projectStatus.completed') %></option></select></div>
    <div class="form-field"><label for="gas_service_status"><%= t('adminCoverage.gasServiceStatusLabel') %></label><select class="form-control" id="gas_service_status" name="gas_service_status"><option value="unknown" <%= (!area||area.gas_service_status==='unknown')?'selected':'' %>><%= t('coverageAdmin.gasStatus.unknown') %></option><option value="not_installed" <%= area?.gas_service_status==='not_installed'?'selected':'' %>><%= t('coverageAdmin.gasStatus.not_installed') %></option><option value="planned" <%= area?.gas_service_status==='planned'?'selected':'' %>><%= t('coverageAdmin.gasStatus.planned') %></option><option value="installed" <%= area?.gas_service_status==='installed'?'selected':'' %>><%= t('coverageAdmin.gasStatus.installed') %></option></select></div>
    <div class="form-field"><label for="riser_installation_status"><%= t('adminCoverage.riserInstallLabel') %></label><select class="form-control" id="riser_installation_status" name="riser_installation_status"><option value="unknown" <%= (!area||area.riser_installation_status==='unknown')?'selected':'' %>><%= t('coverageAdmin.gasStatus.unknown') %></option><option value="not_installed" <%= area?.riser_installation_status==='not_installed'?'selected':'' %>><%= t('coverageAdmin.gasStatus.not_installed') %></option><option value="planned" <%= area?.riser_installation_status==='planned'?'selected':'' %>><%= t('coverageAdmin.gasStatus.planned') %></option><option value="installed" <%= area?.riser_installation_status==='installed'?'selected':'' %>><%= t('coverageAdmin.gasStatus.installed') %></option></select></div>
    <div class="form-field"><label class="check-line"><input type="checkbox" name="riser_locations_identified" <%= area?.riser_locations_identified?'checked':'' %>> <%= t('adminCoverage.riserLocationCheckbox') %></label></div>
    <div class="form-field"><label class="check-line"><input type="checkbox" name="planned_expansion" <%= area?.planned_expansion?'checked':'' %>> <%= t('adminCoverage.plannedExpansionCheckbox') %></label></div>
    <div class="form-field form-span-2"><label for="description"><%= t('adminCoverage.descriptionLabel') %></label><textarea class="form-control" id="description" name="description" rows="4" maxlength="2000"><%= area?.description || '' %></textarea></div>
    <div class="form-field form-span-2"><label class="check-line"><input type="checkbox" name="is_demo" <%= !area || area.is_demo ? 'checked' : '' %>> <%= t('adminCoverage.isDemoCheckbox') %></label><small><%= t('adminCoverage.isDemoHint') %></small></div>
    <% if (area) { %><div class="form-field"><label><%= t('adminCoverage.lastUpdatedLabel') %></label><p class="muted-text"><%= new Date(area.last_updated).toLocaleString(locale==='en'?'en-US':'fa-IR') %> <%= t('adminCoverage.lastUpdatedHint') %></p></div><% } %>
  </div>
  <div class="form-actions"><button class="button button-primary" type="submit" data-busy-label="<%= t('adminCoverage.saving') %>"><%= t('adminCoverage.save') %></button><a href="/admin/coverage-areas" class="button button-outline"><%= t('adminCoverage.cancel') %></a></div>
</form>
</div></div><%- include('../partials/footer') %>
