<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
<div class="admin-topbar"><div><span class="section-kicker">HORMOZGAN COVERAGE MAP</span><h1><%= area ? 'ویرایش منطقه' : 'منطقهٔ جدید' %></h1><p>این فرم مستقیماً رکورد جدول <code dir="ltr">coverage_areas</code> را می‌سازد/ویرایش می‌کند که منبع نقشهٔ عمومی و فرم درخواست مشاوره است.</p></div><a href="/admin/coverage-areas" class="button button-outline button-small">بازگشت</a></div>
<form class="admin-panel admin-form" action="<%= area ? `/admin/coverage-areas/${area.id}/edit` : '/admin/coverage-areas' %>" method="post" data-unsaved-guard>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-grid">
    <div class="form-field form-span-2"><label for="project_name">نام پروژه / منطقه *</label><input class="form-control" id="project_name" name="project_name" maxlength="200" value="<%= area?.project_name || '' %>" required></div>
    <div class="form-field"><label for="province">استان</label><input class="form-control" id="province" name="province" value="<%= area?.province || 'هرمزگان' %>"></div>
    <div class="form-field"><label for="city">شهر *</label><input class="form-control" id="city" name="city" maxlength="120" value="<%= area?.city || '' %>" required></div>
    <div class="form-field"><label for="district">محله / منطقه</label><input class="form-control" id="district" name="district" maxlength="120" value="<%= area?.district || '' %>"></div>
    <div class="form-field"><label for="approximate_location_label">برچسب موقعیت تقریبی</label><input class="form-control" id="approximate_location_label" name="approximate_location_label" maxlength="200" value="<%= area?.approximate_location_label || '' %>" placeholder="مثلاً بندرعباس - مرکز شهر (تقریبی)"></div>
    <div class="form-field"><label for="lat">عرض جغرافیایی (lat) *</label><input class="form-control" dir="ltr" id="lat" name="lat" type="number" step="0.0001" value="<%= area?.lat ?? '' %>" required></div>
    <div class="form-field"><label for="lng">طول جغرافیایی (lng) *</label><input class="form-control" dir="ltr" id="lng" name="lng" type="number" step="0.0001" value="<%= area?.lng ?? '' %>" required></div>
    <div class="form-field"><label for="project_count">تعداد پروژه</label><input class="form-control" id="project_count" name="project_count" type="number" min="0" value="<%= area?.project_count ?? 0 %>"></div>
    <div class="form-field form-span-2"><label for="service_type">خدمات مهندسی موجود</label><input class="form-control" id="service_type" name="service_type" maxlength="200" value="<%= area?.service_type || '' %>" placeholder="مثلاً ارزیابی مهندسی گاز، برداشت وضع موجود"></div>
    <div class="form-field"><label for="project_status">وضعیت پروژه</label><select class="form-control" id="project_status" name="project_status"><option value="under_review" <%= (!area||area.project_status==='under_review')?'selected':'' %>>در حال بررسی</option><option value="planned" <%= area?.project_status==='planned'?'selected':'' %>>برنامه‌ریزی‌شده</option><option value="in_progress" <%= area?.project_status==='in_progress'?'selected':'' %>>در حال اجرا</option><option value="completed" <%= area?.project_status==='completed'?'selected':'' %>>تکمیل‌شده</option></select></div>
    <div class="form-field"><label for="gas_service_status">وضعیت خدمات گاز</label><select class="form-control" id="gas_service_status" name="gas_service_status"><option value="unknown" <%= (!area||area.gas_service_status==='unknown')?'selected':'' %>>نامشخص</option><option value="not_installed" <%= area?.gas_service_status==='not_installed'?'selected':'' %>>نصب‌نشده</option><option value="planned" <%= area?.gas_service_status==='planned'?'selected':'' %>>برنامه‌ریزی‌شده</option><option value="installed" <%= area?.gas_service_status==='installed'?'selected':'' %>>نصب‌شده</option></select></div>
    <div class="form-field"><label for="riser_installation_status">وضعیت نصب رایزر</label><select class="form-control" id="riser_installation_status" name="riser_installation_status"><option value="unknown" <%= (!area||area.riser_installation_status==='unknown')?'selected':'' %>>نامشخص</option><option value="not_installed" <%= area?.riser_installation_status==='not_installed'?'selected':'' %>>نصب‌نشده</option><option value="planned" <%= area?.riser_installation_status==='planned'?'selected':'' %>>برنامه‌ریزی‌شده</option><option value="installed" <%= area?.riser_installation_status==='installed'?'selected':'' %>>نصب‌شده</option></select></div>
    <div class="form-field"><label class="check-line"><input type="checkbox" name="riser_locations_identified" <%= area?.riser_locations_identified?'checked':'' %>> محل رایزر شناسایی شده است</label></div>
    <div class="form-field"><label class="check-line"><input type="checkbox" name="planned_expansion" <%= area?.planned_expansion?'checked':'' %>> توسعهٔ آتی برنامه‌ریزی‌شده است</label></div>
    <div class="form-field form-span-2"><label for="description">توضیحات</label><textarea class="form-control" id="description" name="description" rows="4" maxlength="2000"><%= area?.description || '' %></textarea></div>
    <div class="form-field form-span-2"><label class="check-line"><input type="checkbox" name="is_demo" <%= !area || area.is_demo ? 'checked' : '' %>> داده نمایشی/آزمایشی است (پیش از تأیید آرشیو واقعی نوین گیتی)</label><small>تا این گزینه فعال باشد، منطقه روی نقشهٔ عمومی به‌عنوان داده نمونه/preliminary علامت‌گذاری می‌شود. فقط پس از تأیید داده‌های واقعی این تیک را بردارید.</small></div>
    <% if (area) { %><div class="form-field"><label>آخرین به‌روزرسانی</label><p class="muted-text"><%= new Date(area.last_updated).toLocaleString('fa-IR') %> (هنگام ذخیره خودکار به‌روز می‌شود)</p></div><% } %>
  </div>
  <div class="form-actions"><button class="button button-primary" type="submit" data-busy-label="در حال ذخیره…">ذخیره منطقه</button><a href="/admin/coverage-areas" class="button button-outline">انصراف</a></div>
</form>
</div></div><%- include('../partials/footer') %>
