<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
<div class="admin-topbar"><div><span class="section-kicker">EDITORIAL / CMS</span><h1>مقالات و مجله</h1><p>مقاله‌ها، تصویر شاخص، متن و وضعیت انتشار از همین پنل کنترل می‌شوند.</p></div><a href="/admin/articles/new" class="button button-primary">＋ مقاله جدید</a></div>
<section class="admin-panel">
  <form class="filter-bar" method="get" action="/admin/articles" role="search">
    <div class="filter-field filter-grow"><label for="f-q">جست‌وجو</label><input class="form-control" id="f-q" name="q" type="search" value="<%= filters.q %>" placeholder="عنوان، نشانی کوتاه یا دسته" maxlength="100"></div>
    <div class="filter-field"><label for="f-status">وضعیت</label><select class="form-control" id="f-status" name="status"><option value="">همه</option><% ['published','draft','archived'].forEach(s => { %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= statusLabels[s] %></option><% }) %></select></div>
    <div class="filter-actions"><button class="button button-dark button-small" type="submit">اعمال</button><% if (filters.q || filters.status) { %><a class="button button-quiet button-small" href="/admin/articles">حذف فیلترها</a><% } %></div>
  </form>
  <div class="table-responsive"><table class="data-table"><caption class="sr-only">فهرست مقالات</caption><thead><tr><th scope="col">عنوان مقاله</th><th scope="col">دسته</th><th scope="col">تصویر</th><th scope="col">وضعیت</th><th scope="col">آخرین تغییر</th><th scope="col"><span class="sr-only">عملیات</span></th></tr></thead><tbody>
  <% articles.forEach(a=>{ %><tr><td><div class="table-product"><span class="table-product-image"><% if(a.cover_image){ %><img src="<%= a.cover_image %>" alt="" loading="lazy"><% }else{ %><b>N</b><% } %></span><span><b><%= a.title %></b><small class="table-sub" dir="ltr">/<%= a.slug %></small></span></div></td><td><%= a.category %></td><td><%= a.cover_image?'دارد':'ندارد' %></td><td><span class="status-pill status-<%= a.status %>"><%= statusLabels[a.status] %></span></td><td><%= new Date(a.updated_at).toLocaleDateString('fa-IR') %></td><td><div class="row-actions"><a href="/admin/articles/<%= a.id %>/edit">ویرایش</a><% if (a.status==='published') { %><a href="/articles/<%= a.slug %>" target="_blank" rel="noopener">مشاهده</a><% } %><% if (a.status!=='archived') { %><form action="/admin/articles/<%= a.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-link danger-text" type="submit" data-confirm="مقالهٔ «<%= a.title %>» به آرشیو منتقل شود؟" data-confirm-label="آرشیو کن">آرشیو</button></form><% } %></div></td></tr><% }) %>
  <% if(!articles.length){ %><tr><td colspan="6" class="table-empty"><%= (filters.q || filters.status) ? 'مقاله‌ای با این فیلترها پیدا نشد.' : 'هنوز مقاله‌ای ثبت نشده است.' %></td></tr><% } %>
  </tbody></table></div>
  <%- include('../partials/pagination', { pg, base: '/admin/articles', params: filters }) %>
</section></div></div><%- include('../partials/footer') %>
