<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
<div class="admin-topbar"><div><span class="section-kicker">SITE CONFIGURATION</span><h1>تنظیمات عمومی سایت</h1><p>نام، پیام معرفی، راه‌های ارتباطی و متن درباره ما را بدون تغییر کد مدیریت کنید.</p></div></div>
<% const err = k => errors && errors[k]; const field = (k) => err(k) ? `aria-invalid="true" aria-describedby="${k}-error"` : ''; %>
<form class="admin-panel admin-form" action="/admin/settings" method="post" data-unsaved-guard novalidate><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid">
<div class="form-field"><label for="site_name">نام وب‌سایت *</label><input class="form-control" id="site_name" name="site_name" maxlength="100" required value="<%= settings.site_name || 'Nogiti' %>" <%- field('site_name') %>><% if (err('site_name')) { %><small class="field-error" id="site_name-error"><%= err('site_name') %></small><% } %></div>
<div class="form-field"><label for="site_tagline">شعار کوتاه</label><input class="form-control" id="site_tagline" name="site_tagline" maxlength="200" value="<%= settings.site_tagline || '' %>"></div>
<div class="form-field"><label for="contact_email">ایمیل پشتیبانی</label><input class="form-control" id="contact_email" name="contact_email" type="email" dir="ltr" maxlength="180" value="<%= settings.contact_email || '' %>" <%- field('contact_email') %>><% if (err('contact_email')) { %><small class="field-error" id="contact_email-error"><%= err('contact_email') %></small><% } %></div>
<div class="form-field"><label for="contact_phone">تلفن تماس</label><input class="form-control" id="contact_phone" name="contact_phone" dir="ltr" inputmode="tel" maxlength="40" value="<%= settings.contact_phone || '' %>" <%- field('contact_phone') %>><% if (err('contact_phone')) { %><small class="field-error" id="contact_phone-error"><%= err('contact_phone') %></small><% } %></div>
<div class="form-field"><label for="instagram">شناسه اینستاگرام</label><input class="form-control" id="instagram" name="instagram" dir="ltr" maxlength="100" value="<%= settings.instagram || '' %>" <%- field('instagram') %>><% if (err('instagram')) { %><small class="field-error" id="instagram-error"><%= err('instagram') %></small><% } %></div>
<div class="form-field form-span-2"><label for="about_text">متن درباره ما</label><textarea class="form-control" id="about_text" name="about_text" rows="6" maxlength="2000"><%= settings.about_text || '' %></textarea></div>
</div><div class="form-actions"><button class="button button-primary" type="submit" data-busy-label="در حال ذخیره…">ذخیره تنظیمات</button></div></form>
</div></div><%- include('../partials/footer') %>
