<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
<% const crStatusLabels = { new: t('adminConsultation.statusNew'), reviewing: t('adminConsultation.statusReviewing'), contacted: t('adminConsultation.statusContacted'), closed: t('adminConsultation.statusClosed') }; %>
<div class="admin-topbar"><div><span class="section-kicker">ENGINEERING CONSULTATION</span><h1><%= t('admin.consultation.title') %></h1><p><%= t('adminConsultation.subtitle') %></p></div></div>
<section class="admin-panel">
  <form class="filter-bar" method="get" action="/admin/consultation-requests" role="search">
    <div class="filter-field"><label for="f-status"><%= t('adminConsultation.filterStatus') %></label><select class="form-control" id="f-status" name="status"><option value=""><%= t('coverageMap.filterAll') %></option><% ['new','reviewing','contacted','closed'].forEach(s => { %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= crStatusLabels[s] %></option><% }) %></select></div>
    <div class="filter-actions"><button class="button button-dark button-small" type="submit"><%= t('adminConsultation.apply') %></button><% if (filters.status) { %><a class="button button-quiet button-small" href="/admin/consultation-requests"><%= t('common.clearFilters') %></a><% } %></div>
  </form>
  <div class="table-responsive"><table class="data-table"><caption class="sr-only"><%= t('admin.consultation.title') %></caption><thead><tr><th scope="col">#</th><th scope="col"><%= t('adminConsultation.name') %></th><th scope="col"><%= t('consultation.mobile') %></th><th scope="col"><%= t('consultation.city') %></th><th scope="col"><%= t('consultation.requestTypeLabel') %></th><th scope="col"><%= t('common.status') %></th><th scope="col"><%= t('common.date') %></th><th scope="col"></th></tr></thead><tbody>
  <% requests.forEach(r => { %><tr>
    <td>CR-<%= r.id %></td>
    <td><%= r.full_name %></td>
    <td dir="ltr"><%= r.mobile %></td>
    <td><%= r.city %><% if (r.district) { %><small class="table-sub"><%= r.district %></small><% } %></td>
    <td><%= requestTypeLabels[r.request_type] || r.request_type %></td>
    <td><span class="status-pill status-ticket-<%= r.status==='closed'?'closed':(r.status==='new'?'open':'pending') %>"><%= crStatusLabels[r.status] %></span></td>
    <td><%= new Date(r.created_at).toLocaleDateString(locale==='en'?'en-US':'fa-IR') %></td>
    <td>
      <details class="row-details"><summary><%= t('adminConsultation.details') %></summary>
        <div class="row-details-body">
          <p><b><%= t('consultation.contactMethodLabel') %>:</b> <%= contactMethodLabels[r.contact_method] || r.contact_method %></p>
          <p><b><%= t('consultation.projectStatusLabel') %>:</b> <%= projectStatusFormLabels[r.project_status] || r.project_status %></p>
          <% if (r.project_address) { %><p><b><%= t('adminConsultation.address') %>:</b> <%= r.project_address %></p><% } %>
          <p><b><%= t('adminConsultation.projectDescription') %>:</b> <%= r.project_description %></p>
          <% if (r.notes) { %><p><b><%= t('adminConsultation.note') %>:</b> <%= r.notes %></p><% } %>
          <% if (r.preferred_contact_time) { %><p><b><%= t('consultation.preferredContactTime') %>:</b> <%= r.preferred_contact_time %></p><% } %>
          <% if (r.attachment_path) { %><p><b><%= t('adminConsultation.attachment') %>:</b> <a href="<%= r.attachment_path %>" target="_blank" rel="noopener"><img src="<%= r.attachment_path %>" alt="<%= r.full_name %>" class="attachment-thumb" loading="lazy" width="140" height="100"></a></p><% } %>
          <form action="/admin/consultation-requests/<%= r.id %>/status" method="post" class="inline-form status-update-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <select class="form-control" name="status">
              <% ['new','reviewing','contacted','closed'].forEach(s => { %><option value="<%= s %>" <%= r.status===s?'selected':'' %>><%= crStatusLabels[s] %></option><% }) %>
            </select>
            <button class="button button-outline button-small" type="submit"><%= t('adminConsultation.updateStatus') %></button>
          </form>
        </div>
      </details>
    </td>
  </tr><% }) %>
  <% if (!requests.length) { %><tr><td colspan="8" class="table-empty"><%= t('adminConsultation.empty') %></td></tr><% } %>
  </tbody></table></div>
</section></div></div><%- include('../partials/footer') %>
