<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
<div class="admin-topbar"><div><span class="section-kicker">CATALOG / COMMERCE</span><h1>محصولات، دوره‌ها و پلاگین‌ها</h1><p>قیمت و وضعیت انتشار را کنترل کنید و از صفحهٔ ویرایش، فایل‌ها و سرفصل‌ها را اضافه کنید.</p></div><a href="/admin/products/new" class="button button-primary">＋ محصول جدید</a></div>
<section class="admin-panel">
  <form class="filter-bar" method="get" action="/admin/products" role="search">
    <div class="filter-field filter-grow"><label for="f-q">جست‌وجو</label><input class="form-control" id="f-q" name="q" type="search" value="<%= filters.q %>" placeholder="عنوان، نشانی کوتاه یا دسته" maxlength="100"></div>
    <div class="filter-field"><label for="f-status">وضعیت</label><select class="form-control" id="f-status" name="status"><option value="">همه</option><% ['published','draft','archived'].forEach(s => { %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= statusLabels[s] %></option><% }) %></select></div>
    <div class="filter-field"><label for="f-type">نوع</label><select class="form-control" id="f-type" name="type"><option value="">همه</option><option value="course" <%= filters.type==='course'?'selected':'' %>>دوره آموزشی</option><option value="plugin" <%= filters.type==='plugin'?'selected':'' %>>افزونه اتوکد</option></select></div>
    <div class="filter-actions"><button class="button button-dark button-small" type="submit">اعمال</button><% if (filters.q || filters.status || filters.type) { %><a class="button button-quiet button-small" href="/admin/products">حذف فیلترها</a><% } %></div>
  </form>
  <div class="table-responsive"><table class="data-table"><caption class="sr-only">فهرست محصولات</caption><thead><tr><th scope="col">محصول</th><th scope="col">نوع</th><th scope="col">قیمت</th><th scope="col">محتوا</th><th scope="col">وضعیت</th><th scope="col"><span class="sr-only">عملیات</span></th></tr></thead><tbody>
  <% products.forEach(p=>{ %><tr><td><div class="table-product"><span class="table-product-image"><% if(p.cover_image){ %><img src="<%= p.cover_image %>" alt="" loading="lazy"><% }else{ %><b>N</b><% } %></span><span><b><%= p.title %></b><small class="table-sub" dir="ltr">/<%= p.slug %></small></span></div></td><td><%= p.product_type==='course'?'دوره آموزشی':'افزونه اتوکد' %></td><td><%= money(p.price_toman) %></td><td><%= Number(p.asset_count).toLocaleString('fa-IR') %> مورد</td><td><span class="status-pill status-<%= p.status %>"><%= statusLabels[p.status] %></span></td><td><div class="row-actions"><a href="/admin/products/<%= p.id %>/edit">ویرایش</a><% if (p.status==='published') { %><a href="/shop/<%= p.slug %>" target="_blank" rel="noopener">مشاهده</a><% } %><% if (p.status!=='archived') { %><form action="/admin/products/<%= p.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-link danger-text" type="submit" data-confirm="محصول «<%= p.title %>» به آرشیو منتقل شود؟ در فروشگاه نمایش داده نمی‌شود ولی سوابق خرید حفظ می‌شود." data-confirm-label="آرشیو کن">آرشیو</button></form><% } %></div></td></tr><% }) %>
  <% if(!products.length){ %><tr><td colspan="6" class="table-empty"><%= (filters.q || filters.status || filters.type) ? 'محصولی با این فیلترها پیدا نشد.' : 'هنوز محصولی ساخته نشده است.' %></td></tr><% } %>
  </tbody></table></div>
  <%- include('../partials/pagination', { pg, base: '/admin/products', params: filters }) %>
</section></div></div><%- include('../partials/footer') %>
