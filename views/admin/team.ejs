<%- include('../partials/header', {title}) %><div class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content">
<div class="admin-topbar"><div><span class="section-kicker">ABOUT US / TEAM</span><h1><%= t('admin.team.title') %></h1><p><%= t('admin.team.subtitle') %></p></div><a href="/admin/team/new" class="button button-primary button-small">＋ <%= t('admin.team.new') %></a></div>
<section class="admin-panel">
  <div class="table-responsive"><table class="data-table"><caption class="sr-only"><%= t('admin.team.title') %></caption><thead><tr><th scope="col"><%= t('admin.team.photo') %></th><th scope="col"><%= t('admin.team.name') %></th><th scope="col"><%= t('admin.team.role') %></th><th scope="col"><%= t('admin.team.order') %></th><th scope="col"><%= t('admin.team.active') %></th><th scope="col"></th></tr></thead><tbody>
  <% members.forEach(m => { %><tr><td><span class="table-product-image"><% if (m.photo_path) { %><img src="<%= m.photo_path %>" alt=""><% } else { %><b><%= m.name.slice(0,1) %></b><% } %></span></td><td><b><%= m.name %></b></td><td><%= m.role || '—' %></td><td><%= m.display_order %></td><td><span class="status-pill <%= m.is_active ? 'status-published' : 'status-archived' %>"><%= m.is_active ? '✓' : '—' %></span></td><td><div class="row-actions"><a href="/admin/team/<%= m.id %>/edit"><%= t('common.edit') %></a><form action="/admin/team/<%= m.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="button-link danger-text" data-confirm="این عضو تیم حذف شود؟" data-confirm-label="حذف کن"><%= t('common.delete') %></button></form></div></td></tr><% }) %>
  <% if (!members.length) { %><tr><td colspan="6" class="table-empty"><%= t('admin.team.empty') %></td></tr><% } %>
  </tbody></table></div>
</section></div></div><%- include('../partials/footer') %>
